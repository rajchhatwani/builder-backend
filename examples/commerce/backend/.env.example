# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# Deployment mode. development is for local work only; docker-compose.yml defaults to production when this
# is unset, and the seed command refuses to run unless this is a development-like value.
APP_ENV=development
# JSON list (single-quoted so `set -a; . ./.env` keeps the double quotes)
CORS_ORIGINS='["*"]'

# --- Authentication -------------------------------------------------------------------
# RSA private key that signs access tokens (RS256). Other services can verify tokens with the
# public key served at /auth/jwks.json. Generate one and paste the line it prints over the one below:
#   docker run --rm -v "$PWD":/srv -w /srv python:3.12-slim sh -c "pip install -q cryptography && python -m app.auth.keys"
AUTH_JWT_PRIVATE_KEY=
# Refresh tokens are kept in Redis (docker compose provides one).
REDIS_URL=redis://localhost:6379/0
# Credentials for host.docker.internal:1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Search (GET /<entity>/search) ---------------------------------------------------------
# fts = Postgres full-text (default). opensearch needs SEARCH_OPENSEARCH_URL (startup refuses without it).
SEARCH_BACKEND=fts
# SEARCH_OPENSEARCH_URL=https://opensearch.internal:9200
# SEARCH_OPENSEARCH_API_KEY=
