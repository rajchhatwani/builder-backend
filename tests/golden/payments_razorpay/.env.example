# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# Deployment mode. development is for local work only; docker-compose.yml defaults to production when this
# is unset, and the seed command refuses to run unless this is a development-like value.
APP_ENV=development
# JSON list
CORS_ORIGINS=["*"]

# --- Authentication -------------------------------------------------------------------
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
# Credentials for smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Payments (razorpay) ---------------------------------------------------------
# Secrets: environment only, never committed. (NAME_FILE=/run/secrets/x reads a secret from a file.)
# Test mode keys (rzp_test_...) outside production. Live keys only work with APP_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The signing secret(s) of the webhook endpoint (comma-separate two while rotating).
RAZORPAY_WEBHOOK_SECRETS=
# inline = process a webhook inside its request, queued = hand it to the workers.
PAYMENTS_WEBHOOK_MODE=inline
# Sizing for the expected load (10 payments/minute at peak). Estimates:
# see deploy/DEPLOYMENT.md before relying on them.
UVICORN_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
WORKER_REPLICAS=1
PAYMENTS_WORKER_CONCURRENCY=8
