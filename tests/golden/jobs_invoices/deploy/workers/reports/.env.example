# Settings for worker group "reports" (copy to .env next to compose.yml).
APP_IMAGE=registry.example.com/invoice-jobs:1.0.0
# This machine's database login (needs read/write on the jb_* tables and on whatever your handlers touch).
DATABASE_URL=postgresql+asyncpg://worker:CHANGE_ME@db.example.com:5432/app?ssl=require
WORKER_REPLICAS=1
JOBS_CONCURRENCY=2
DB_POOL_SIZE=4
