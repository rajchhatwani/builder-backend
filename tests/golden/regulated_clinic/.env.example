# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# Deployment mode. development is for local work only; docker-compose.yml defaults to production when this
# is unset, and the seed command refuses to run unless this is a development-like value.
APP_ENV=development
# JSON list (single-quoted so `set -a; . ./.env` keeps the double quotes)
CORS_ORIGINS='["*"]'

# --- Authentication -------------------------------------------------------------------
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
# Credentials for smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Regulated mode (app/regulated) --------------------------------------------------------
# Protected fields are encrypted at rest with YOUR keys. Never put a key in this file or in version control.
# file (default): a key file with one `<keyid> <urlsafe-base64 of 32 random bytes>` per line, mode 0600.
#   The FIRST line is the active key; later lines only decrypt (keep them until `python -m app.regulated.reencrypt`).
#   Generate a key: python3 -c "import base64, os; print('k1', base64.urlsafe_b64encode(os.urandom(32)).decode())"
# command: a command (no shell, 10 s timeout) that prints the same lines, e.g. a wrapper around your KMS CLI.
# env (development only): derives a key from SECRET_KEY; refused when APP_ENV is not a development name.
# REGULATED_KEY_PROVIDER=file
REGULATED_KEY_FILE=
# REGULATED_KEY_COMMAND=

# --- Compliance (app/compliance) -----------------------------------------------------------
# The salt of the de-identified export: hashed fields are HMAC-SHA256 under it, row ids become pseudonyms under it.
# At least 16 characters; keep it secret and stable (changing it changes every pseudonym). Never commit it.
#   Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COMPLIANCE_EXPORT_SALT=
