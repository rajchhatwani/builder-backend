{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::pay-and-files",
        "arn:aws:s3:::pay-and-files/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyOldTlsVersions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::pay-and-files",
        "arn:aws:s3:::pay-and-files/*"
      ],
      "Condition": { "NumericLessThan": { "s3:TlsVersion": 1.2 } }
    }
  ]
}
