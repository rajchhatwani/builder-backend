# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# Deployment mode. development is for local work only; docker-compose.yml defaults to production when this
# is unset, and the seed command refuses to run unless this is a development-like value.
APP_ENV=development
# JSON list
CORS_ORIGINS=["*"]

# --- Authentication (Keycloak) --------------------------------------------------------
# Where people reach Keycloak: the address in their browser. Tokens are only accepted from
# exactly this issuer, and it must be https when APP_ENV=production.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Port Keycloak is published on (change KEYCLOAK_PUBLIC_URL to match).
KEYCLOAK_PORT=8081
# With APP_ENV=production (set above) a plain http Keycloak address is refused.
# Where this API is reachable. Swagger UI (/docs) signs in through Keycloak and returns here.
API_PUBLIC_URL=http://localhost:8000

# Keycloak's own database. Choose a long random password.
KEYCLOAK_DB_PASSWORD=
# The first Keycloak admin (used once to create your real admin account, then remove them).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Credentials for smtp.example.com:587 (Keycloak sends the emails)
SMTP_USERNAME=
SMTP_PASSWORD=
# Client secret of the corp login (from the provider's console)
KC_IDP_CORP_CLIENT_SECRET=
# Client secret of the gh login (from the provider's console)
KC_IDP_GH_CLIENT_SECRET=
# Client secret of the google login (from the provider's console)
KC_IDP_GOOGLE_CLIENT_SECRET=
# Client secret of the work login (from the provider's console)
KC_IDP_WORK_CLIENT_SECRET=
# Start once with true to move this database to a different identity provider on purpose.
AUTH_ALLOW_PROVIDER_SWITCH=false
