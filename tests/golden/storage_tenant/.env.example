# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# JSON list
CORS_ORIGINS=["*"]

# --- Authentication -------------------------------------------------------------------
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
# Credentials for smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- File storage ---------------------------------------------------------------------
# Secrets: environment only, never committed. (NAME_FILE=/run/secrets/x reads a secret from a file.)
# Full guide: deploy/storage/STORAGE.md. Bucket: team-files
# Your S3-compatible server (compose starts a local development one at http://objectstore:8333).
# Must be https:// when APP_ENV=production.
STORAGE_ENDPOINT_URL=http://localhost:8333
# Credentials of that server. The local development server takes these as its own admin login;
# use a credential limited to the bucket for a real one. Choose long random values.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Development only: create the bucket if it is missing.
STORAGE_CREATE_BUCKET=true
# Address browsers use for presigned download links, if it differs from the one above.
# STORAGE_PUBLIC_ENDPOINT_URL=
# auto: SSE-S3 on AWS, none on a custom endpoint. Or AES256, aws:kms (with STORAGE_KMS_KEY_ID), none.
STORAGE_SSE=auto
# Reverse proxies whose X-Forwarded-For is believed when the audit trail records an address.
STORAGE_TRUSTED_PROXIES=0
# The malware scanner (the compose service of that name).
CLAMD_HOST=localhost
CLAMD_PORT=3310
APP_ENV=development
