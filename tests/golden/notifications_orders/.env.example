# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# Deployment mode. development is for local work only; docker-compose.yml defaults to production when this
# is unset, and the seed command refuses to run unless this is a development-like value.
APP_ENV=development
# JSON list
CORS_ORIGINS=["*"]

# --- Authentication -------------------------------------------------------------------
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
# Credentials for smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Provider credential vault (app/providers) ---------------------------------------------
# Master key that encrypts every tenant's provider credentials (at least 32 characters; production
# refuses to start without it). Generate one and keep it out of version control:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PROVIDER_VAULT_KEY=
PROVIDER_VAULT_KEY_VERSION=1
# Rotation: raise the version, put the new key above and the old one here as version=key, then run
# `python -m app.providers.reencrypt`.
PROVIDER_VAULT_KEY_PREVIOUS=
