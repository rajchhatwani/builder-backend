{
  "spec_version": 1,
  "project": {
    "name": "Combined Async",
    "slug": "combined-async",
    "description": "Events, API edge, jobs and providers enabled together (one migration chain)",
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Customer",
      "table_name": "customers",
      "plural_path": "customers",
      "options": {
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "max_length": 120
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "max_length": 200
        },
        {
          "name": "api_token",
          "type": "string",
          "required": false,
          "max_length": 100
        }
      ]
    },
    {
      "name": "Order",
      "table_name": "orders",
      "plural_path": "orders",
      "options": {
        "filterable": [
          "status"
        ],
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "reference",
          "type": "string",
          "required": true,
          "max_length": 60
        },
        {
          "name": "total",
          "type": "decimal",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum_values": [
            "draft",
            "submitted",
            "approved"
          ]
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "one_to_many",
      "from_entity": "Customer",
      "to_entity": "Order",
      "from_name": "orders",
      "to_name": "customer",
      "on_delete": "restrict",
      "required": false
    }
  ],
  "auth": {
    "enabled": true,
    "multi_tenant": true,
    "app_url": "https://orders.example.com",
    "password_reset": {
      "email_magic_link": false,
      "sms_otp": false,
      "otp_ttl_minutes": 10
    },
    "registration": {
      "email_verification_required": false
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "manager",
        "label": "Manager",
        "inherits_from": "member"
      },
      {
        "name": "member",
        "label": "Member",
        "is_default": true
      }
    ],
    "permissions": [
      {
        "entity": "Customer",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      }
    ],
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_email": "noreply@orders.example.com",
      "from_name": "Order Desk"
    }
  },
  "settings": [],
  "sequences": [],
  "lists": [],
  "state_machines": [
    {
      "entity": "Order",
      "field": "status",
      "initial": "draft",
      "transitions": [
        {
          "name": "submit",
          "from_states": [
            "draft"
          ],
          "to_state": "submitted",
          "auto": false,
          "roles": []
        },
        {
          "name": "approve",
          "from_states": [
            "submitted"
          ],
          "to_state": "approved",
          "auto": false,
          "roles": [
            "manager",
            "admin"
          ]
        }
      ]
    }
  ],
  "seed": [],
  "events": {
    "enabled": true,
    "adapter": "in_process",
    "retention_days": 14
  },
  "api_edge": {
    "enabled": true,
    "idempotency": {
      "methods": [
        "POST"
      ],
      "ttl_hours": 24,
      "max_response_bytes": 65536
    },
    "rate_limits": {
      "user": {
        "capacity": 1000,
        "refill_per_second": 100.0
      },
      "tenant": null,
      "anonymous": {
        "capacity": 200,
        "refill_per_second": 100.0
      },
      "groups": [
        {
          "name": "writes",
          "path_prefix": "/orders",
          "methods": [
            "POST"
          ],
          "user": {
            "capacity": 500,
            "refill_per_second": 50.0
          },
          "tenant": null,
          "cost": 2
        }
      ],
      "read_fail_open": false
    },
    "quotas": [
      {
        "meter": "order_writes",
        "period": "month",
        "limit": 1000000,
        "path_prefix": "/orders",
        "methods": [
          "POST"
        ],
        "cost": 1
      }
    ],
    "versioning": {
      "default": "2026-11-01",
      "versions": [
        {
          "date": "2026-01-15",
          "note": "First public version"
        },
        {
          "date": "2026-06-01",
          "note": "Orders: reference replaces ref"
        },
        {
          "date": "2026-11-01",
          "note": "Pages: items and total only"
        }
      ]
    }
  },
  "providers": {
    "enabled": true,
    "admin_role": "admin",
    "adapters": [
      {
        "kind": "email",
        "name": "acme_mail",
        "settings": {
          "from_name": "Notify Desk",
          "region": "eu"
        }
      },
      {
        "kind": "sms",
        "name": "acme_sms",
        "settings": {}
      }
    ],
    "timeout_seconds": 10.0,
    "max_attempts": 3,
    "breaker_failures": 5,
    "breaker_reset_seconds": 30.0
  },
  "jobs": {
    "enabled": true,
    "queue": {
      "backend": "postgres"
    },
    "worker_groups": [
      {
        "name": "default",
        "concurrency": 4,
        "queues": [
          "default"
        ],
        "placement": "same_server"
      },
      {
        "name": "reports",
        "concurrency": 2,
        "queues": [
          "reports"
        ],
        "placement": "separate_server"
      }
    ],
    "jobs": [
      {
        "name": "send_invoice",
        "queue": "default",
        "handler": "send_invoice",
        "retry": {
          "max_attempts": 4,
          "backoff_seconds": 5,
          "backoff": "exponential"
        },
        "timeout_seconds": 60
      },
      {
        "name": "weekly_dunning",
        "queue": "reports",
        "handler": "run_weekly_dunning",
        "retry": {
          "max_attempts": 2,
          "backoff_seconds": 60,
          "backoff": "fixed"
        },
        "timeout_seconds": 600
      }
    ],
    "schedules": [
      {
        "name": "weekly_dunning_monday",
        "job": "weekly_dunning",
        "cron": "0 6 * * 1",
        "timezone": "Asia/Kolkata",
        "enabled": true,
        "missed": "catch_up_one"
      }
    ]
  }
}
