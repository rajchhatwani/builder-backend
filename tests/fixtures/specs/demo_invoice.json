{
  "spec_version": 1,
  "project": {
    "name": "Invoice Approval Demo",
    "slug": "demo-invoice",
    "description": null,
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Supplier",
      "table_name": "suppliers",
      "plural_path": "suppliers",
      "options": {
        "filterable": [
          "active"
        ],
        "sortable": [
          "name"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "max_length": 80
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "unique": true,
          "max_length": 120
        },
        {
          "name": "payment_terms",
          "type": "string",
          "max_length": 40
        },
        {
          "name": "active",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "name": "Invoice",
      "table_name": "invoices",
      "plural_path": "invoices",
      "options": {
        "filterable": [
          "status"
        ],
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "invoice_no",
          "type": "string",
          "required": true,
          "unique": true,
          "max_length": 40
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "min_value": 0
        },
        {
          "name": "po_amount",
          "type": "decimal",
          "required": true,
          "min_value": 0
        },
        {
          "name": "due_date",
          "type": "date"
        },
        {
          "name": "memo",
          "type": "string",
          "max_length": 200
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum_values": [
            "draft",
            "submitted",
            "pending_approval",
            "approved",
            "paid",
            "rejected"
          ]
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "one_to_many",
      "from_entity": "Supplier",
      "to_entity": "Invoice",
      "from_name": "invoices",
      "to_name": "supplier",
      "on_delete": "restrict",
      "required": true
    }
  ],
  "auth": {
    "enabled": true,
    "deletion_mode": "hard",
    "security_headers_enabled": false,
    "registration": {
      "email_verification_required": false
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "approver",
        "label": "Approver"
      },
      {
        "name": "clerk",
        "label": "Clerk"
      }
    ],
    "permissions": [
      {
        "entity": "Supplier",
        "operation": "create",
        "roles": [
          "admin",
          "clerk"
        ]
      },
      {
        "entity": "Supplier",
        "operation": "list",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ]
      },
      {
        "entity": "Supplier",
        "operation": "get",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ]
      },
      {
        "entity": "Supplier",
        "operation": "update",
        "roles": [
          "admin"
        ]
      },
      {
        "entity": "Supplier",
        "operation": "delete",
        "roles": [
          "admin"
        ]
      },
      {
        "entity": "Invoice",
        "operation": "create",
        "roles": [
          "clerk",
          "admin"
        ]
      },
      {
        "entity": "Invoice",
        "operation": "list",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ]
      },
      {
        "entity": "Invoice",
        "operation": "get",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ]
      },
      {
        "entity": "Invoice",
        "operation": "update",
        "roles": [
          "admin"
        ]
      },
      {
        "entity": "Invoice",
        "operation": "delete",
        "roles": [
          "admin"
        ]
      }
    ],
    "password_reset": {
      "email_magic_link": false,
      "sms_otp": false,
      "otp_ttl_minutes": 10
    }
  },
  "state_machines": [
    {
      "entity": "Invoice",
      "field": "status",
      "initial": "draft",
      "transitions": [
        {
          "name": "submit",
          "from_states": [
            "draft"
          ],
          "to_state": "submitted",
          "roles": [
            "clerk",
            "admin"
          ]
        },
        {
          "name": "auto_approve",
          "from_states": [
            "submitted"
          ],
          "to_state": "approved",
          "auto": true,
          "when": "amount <= 10000 and abs(amount - po_amount) <= po_amount * 0.02"
        },
        {
          "name": "needs_approval",
          "from_states": [
            "submitted"
          ],
          "to_state": "pending_approval",
          "auto": true,
          "when": "amount > 10000 or abs(amount - po_amount) > po_amount * 0.02"
        },
        {
          "name": "approve",
          "from_states": [
            "pending_approval"
          ],
          "to_state": "approved",
          "roles": [
            "approver"
          ],
          "when": "amount <= 50000"
        },
        {
          "name": "approve_large",
          "from_states": [
            "pending_approval"
          ],
          "to_state": "approved",
          "roles": [
            "admin"
          ]
        },
        {
          "name": "reject",
          "from_states": [
            "pending_approval"
          ],
          "to_state": "rejected",
          "roles": [
            "approver",
            "admin"
          ]
        },
        {
          "name": "pay",
          "from_states": [
            "approved"
          ],
          "to_state": "paid",
          "roles": [
            "admin"
          ]
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "approval_threshold",
      "type": "int",
      "default": 10000,
      "label": "Invoices above this amount need an approver",
      "minimum": 0,
      "maximum": 1000000,
      "edit_roles": [
        "admin",
        "approver"
      ]
    },
    {
      "key": "payment_grace_days",
      "type": "int",
      "default": 5,
      "label": "Days after the due date before an invoice is late",
      "minimum": 0,
      "maximum": 90,
      "read_roles": [
        "approver",
        "admin"
      ],
      "edit_roles": [
        "admin"
      ]
    }
  ],
  "sequences": [
    {
      "name": "invoice_no",
      "prefix": "INV-",
      "padding": 5,
      "view_roles": [
        "admin"
      ]
    }
  ],
  "lists": [
    {
      "name": "invoice_status",
      "label": "Invoice statuses",
      "max_items": 12,
      "edit_roles": [
        "admin"
      ],
      "items": [
        {
          "value": "draft",
          "label": "Draft",
          "color": "#6b7280",
          "locked": true
        },
        {
          "value": "pending_approval",
          "label": "Waiting for approval",
          "color": "#d97706"
        },
        {
          "value": "approved",
          "label": "Approved",
          "color": "#16a34a"
        },
        {
          "value": "paid",
          "label": "Paid",
          "color": "#2563eb"
        },
        {
          "value": "rejected",
          "label": "Rejected",
          "color": "#dc2626"
        }
      ]
    }
  ],
  "history": [
    {
      "entity": "Invoice",
      "fields": [
        "amount",
        "po_amount",
        "due_date"
      ],
      "retention_days": 365,
      "view_roles": [
        "approver",
        "admin"
      ]
    },
    {
      "entity": "Supplier",
      "fields": [
        "name",
        "email",
        "payment_terms"
      ],
      "retention_days": 365,
      "view_roles": [
        "admin"
      ]
    }
  ],
  "hooks": [
    {
      "name": "match_invoice",
      "point": "Invoice.transition_guard(submit)",
      "kind": "pure",
      "input": {
        "name": "MatchInput",
        "fields": [
          {
            "name": "invoice_no",
            "type": "string",
            "required": true
          },
          {
            "name": "amount",
            "type": "decimal",
            "required": true
          },
          {
            "name": "po_amount",
            "type": "decimal",
            "required": true
          }
        ]
      },
      "output": {
        "name": "MatchResult",
        "fields": [
          {
            "name": "allowed",
            "type": "bool",
            "required": true
          },
          {
            "name": "reason",
            "type": "string",
            "required": false
          }
        ]
      },
      "failure_policy": "fail_closed",
      "fallback": null,
      "budget": {
        "cpu_ms": 200,
        "rows": 0,
        "outbound_calls": 0
      },
      "reads": []
    }
  ],
  "seed": [
    {
      "name": "demo",
      "seed": 20261101,
      "as_of": "2026-10-01",
      "tenants": 0,
      "entities": [
