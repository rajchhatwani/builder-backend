{
  "spec_version": 1,
  "project": {
    "name": "Notify Desk",
    "slug": "notify-desk",
    "description": "Customers and orders with per-tenant email and SMS providers behind a credential vault",
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Customer",
      "table_name": "customers",
      "plural_path": "customers",
      "options": {
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "max_length": 120
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "max_length": 200
        },
        {
          "name": "api_token",
          "type": "string",
          "required": false,
          "max_length": 100
        }
      ]
    },
    {
      "name": "Order",
      "table_name": "orders",
      "plural_path": "orders",
      "options": {
        "filterable": [
          "status"
        ],
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "reference",
          "type": "string",
          "required": true,
          "max_length": 60
        },
        {
          "name": "total",
          "type": "decimal",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum_values": [
            "draft",
            "submitted",
            "approved"
          ]
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "one_to_many",
      "from_entity": "Customer",
      "to_entity": "Order",
      "from_name": "orders",
      "to_name": "customer",
      "on_delete": "restrict",
      "required": false
    }
  ],
  "auth": {
    "enabled": true,
    "multi_tenant": true,
    "app_url": "https://notify.example.com",
    "password_reset": {
      "email_magic_link": false,
      "sms_otp": false,
      "otp_ttl_minutes": 10
    },
    "registration": {
      "email_verification_required": false
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "manager",
        "label": "Manager",
        "inherits_from": "member"
      },
      {
        "name": "member",
        "label": "Member",
        "is_default": true
      }
    ],
    "permissions": [
      {
        "entity": "Customer",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      }
    ],
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_email": "noreply@orders.example.com",
      "from_name": "Order Desk"
    }
  },
  "settings": [],
  "sequences": [],
  "lists": [],
  "state_machines": [],
  "seed": [],
  "providers": {
    "enabled": true,
    "admin_role": "admin",
    "adapters": [
      {
        "kind": "email",
        "name": "acme_mail",
        "settings": {
          "from_name": "Notify Desk",
          "region": "eu"
        }
      },
      {
        "kind": "sms",
        "name": "acme_sms",
        "settings": {}
      }
    ],
    "timeout_seconds": 10.0,
    "max_attempts": 3,
    "breaker_failures": 5,
    "breaker_reset_seconds": 30.0
  }
}
