{
  "spec_version": 1,
  "project": {
    "name": "Effect Orders",
    "slug": "effect-orders",
    "description": "Orders with an effectful hook: opt-in, trusted authors only, budgets",
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Customer",
      "table_name": "customers",
      "plural_path": "customers",
      "options": {
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "max_length": 120
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "max_length": 200
        },
        {
          "name": "api_token",
          "type": "string",
          "required": false,
          "max_length": 100
        }
      ]
    },
    {
      "name": "Order",
      "table_name": "orders",
      "plural_path": "orders",
      "options": {
        "filterable": [
          "status"
        ],
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "reference",
          "type": "string",
          "required": true,
          "max_length": 60
        },
        {
          "name": "total",
          "type": "decimal",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum_values": [
            "draft",
            "submitted",
            "approved"
          ]
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "one_to_many",
      "from_entity": "Customer",
      "to_entity": "Order",
      "from_name": "orders",
      "to_name": "customer",
      "on_delete": "restrict",
      "required": false
    }
  ],
  "auth": {
    "enabled": true,
    "multi_tenant": true,
    "app_url": "https://notify.example.com",
    "password_reset": {
      "email_magic_link": false,
      "sms_otp": false,
      "otp_ttl_minutes": 10
    },
    "registration": {
      "email_verification_required": false
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "manager",
        "label": "Manager",
        "inherits_from": "member"
      },
      {
        "name": "member",
        "label": "Member",
        "is_default": true
      }
    ],
    "permissions": [
      {
        "entity": "Customer",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "create",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "list",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "get",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "update",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Order",
        "operation": "delete",
        "roles": [
          "member",
          "manager",
          "admin"
        ],
        "row_rule": "tenant"
      }
    ],
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_email": "noreply@orders.example.com",
      "from_name": "Order Desk"
    }
  },
  "settings": [],
  "sequences": [],
  "lists": [],
  "state_machines": [],
  "seed": [],
  "providers": {
    "enabled": true,
    "admin_role": "admin",
    "adapters": [
      {
        "kind": "email",
        "name": "acme_mail",
        "settings": {
          "from_name": "Notify Desk",
          "region": "eu"
        }
      },
      {
        "kind": "sms",
        "name": "acme_sms",
        "settings": {}
      }
    ],
    "timeout_seconds": 10.0,
    "max_attempts": 3,
    "breaker_failures": 5,
    "breaker_reset_seconds": 30.0
  },
  "events": {
    "enabled": true,
    "adapter": "in_process",
    "retention_days": 14
  },
  "notifications": {
    "enabled": true,
    "admin_role": "admin",
    "max_attempts": 3,
    "backoff_seconds": 5,
    "retention_days": 30,
    "types": [
      {
        "name": "welcome",
        "category": "optional",
        "channels": [
          "email"
        ],
        "variables": [
          "name"
        ],
        "on_event": "customer.created",
        "recipient_key_field": "id",
        "address_fields": {
          "email": "email"
        },
        "templates": [
          {
            "channel": "email",
            "subject": "Welcome {{ name }}",
            "body": "<p>Hello {{ name }}, welcome aboard.</p>",
            "html": true
          }
        ]
      },
      {
        "name": "order_shipped",
        "category": "optional",
        "channels": [
          "email",
          "sms",
          "push"
        ],
        "variables": [
          "order",
          "tracking"
        ],
        "templates": [
          {
            "channel": "email",
            "subject": "Order {{ order }} shipped",
            "body": "Your order {{ order }} is on its way. Tracking: {{ tracking }}",
            "html": false
          },
          {
            "channel": "sms",
            "body": "Order {{ order }} shipped: {{ tracking }}"
          },
          {
            "channel": "push",
            "subject": "Order shipped",
            "body": "{{ order }} is on its way"
          }
        ]
      },
      {
        "name": "security_alert",
        "category": "transactional",
        "channels": [
          "email",
          "sms"
        ],
        "variables": [
          "detail"
        ],
        "templates": [
          {
            "channel": "email",
            "subject": "Security alert",
            "body": "Security alert: {{ detail }}"
          },
          {
            "channel": "sms",
            "body": "Security alert: {{ detail }}"
          }
        ]
      }
    ]
  },
  "hook_effects": {
    "enabled": true,
    "trusted_authors_only": true,
    "webhook_hosts": []
  },
  "hooks": [
    {
      "name": "announce_order",
      "point": "Order.after_commit",
      "kind": "effect",
      "input": {
        "name": "AnnounceInput",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "required": true
          },
          {
            "name": "reference",
            "type": "string",
            "required": true
          }
        ]
      },
      "output": {
        "name": "AnnounceResult",
        "fields": [
          {
            "name": "sent",
            "type": "bool",
            "required": true
          }
        ]
      },
      "failure_policy": "fallback",
      "fallback": {
        "sent": false
      },
      "budget": {
        "cpu_ms": 1000,
        "rows": 0,
        "outbound_calls": 0
      },
      "effects": [
        "email",
        "notification"
      ],
      "effect_budget": {
        "calls_per_effect": 2,
        "payload_bytes": 2000,
        "outbound_per_minute": 10
      },
      "author": "trusted"
    }
  ]
}