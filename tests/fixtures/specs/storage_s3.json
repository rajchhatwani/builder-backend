{
  "project": {
    "name": "Gallery",
    "slug": "gallery",
    "description": "Photos with uploaded files",
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Photo",
      "table_name": "photos",
      "plural_path": "photos",
      "fields": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "max_length": 120
        },
        {
          "name": "image_id",
          "type": "file",
          "required": true
        },
        {
          "name": "thumbnail_id",
          "type": "file",
          "required": false
        }
      ]
    }
  ],
  "relations": [],
  "auth": {
    "enabled": true,
    "app_url": "https://gallery.example.com",
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_email": "noreply@gallery.example.com",
      "from_name": "Gallery"
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "member",
        "label": "Member"
      },
      {
        "name": "contributor",
        "label": "Contributor"
      },
      {
        "name": "viewer",
        "label": "Viewer"
      },
      {
        "name": "guest",
        "label": "Guest",
        "is_default": true
      }
    ],
    "permissions": [
      {
        "entity": "Photo",
        "operation": "list",
        "roles": [
          "viewer",
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "get",
        "roles": [
          "viewer",
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "head",
        "roles": [
          "viewer",
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "create",
        "roles": [
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "replace",
        "roles": [
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "update",
        "roles": [
          "member",
          "admin"
        ]
      },
      {
        "entity": "Photo",
        "operation": "delete",
        "roles": [
          "member",
          "admin"
        ]
      }
    ]
  },
  "storage": {
    "enabled": true,
    "backend": "s3",
    "bucket": "gallery-uploads",
    "region": "eu-west-1",
    "key_prefix": "uploads",
    "allowed_types": [],
    "max_file_mb": 25,
    "user_quota_mb": 500,
    "uploads_per_hour": 60,
    "download_mode": "proxy",
    "allow_inline_images": false,
    "roles": {
      "upload": [
        "member",
        "contributor",
        "admin"
      ],
      "share": [
        "admin"
      ],
      "read": [
        "viewer",
        "member",
        "contributor",
        "admin"
      ],
      "read_all": [
        "admin"
      ],
      "delete": [
        "member"
      ],
      "delete_all": [
        "admin"
      ],
      "operate": [
        "admin"
      ]
    },
    "security": {
      "audit_retention_days": 2555,
      "audit_ip": true,
      "rescan_after_days": 30,
      "scan_timeout_seconds": 120
    }
  }
}
