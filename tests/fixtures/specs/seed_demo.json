          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "delete",
        "roles": [
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Invoice",
        "operation": "create",
        "roles": [
          "clerk",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Invoice",
        "operation": "list",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Invoice",
        "operation": "get",
        "roles": [
          "clerk",
          "approver",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Invoice",
        "operation": "update",
        "roles": [
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Invoice",
        "operation": "delete",
        "roles": [
          "admin"
        ],
        "row_rule": "tenant"
      }
    ],
    "password_reset": {
      "email_magic_link": false,
      "sms_otp": false,
      "otp_ttl_minutes": 10
    },
    "multi_tenant": true,
    "app_url": "https://workspace.example.com",
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_email": "noreply@workspace.example.com",
      "from_name": "Workspace"
    }
  },
  "state_machines": [
    {
      "entity": "Invoice",
      "field": "status",
      "initial": "draft",
      "transitions": [
        {
          "name": "submit",
          "from_states": [
            "draft"
          ],
          "to_state": "submitted",
          "roles": [
            "clerk",
            "admin"
          ]
        },
        {
          "name": "auto_approve",
          "from_states": [
            "submitted"
          ],
          "to_state": "approved",
          "auto": true,
          "when": "amount <= 100"
        },
        {
          "name": "approve",
          "from_states": [
            "submitted"
          ],
          "to_state": "approved",
          "roles": [
            "approver",
            "admin"
          ]
        },
        {
          "name": "reject",
          "from_states": [
            "submitted"
          ],
          "to_state": "rejected",
          "roles": [
            "approver",
            "admin"
          ]
        },
        {
          "name": "pay",
          "from_states": [
            "approved"
          ],
          "to_state": "paid",
          "roles": [
            "admin"
          ]
        }
      ]
    }
  ],
  "seed": [
    {
      "name": "demo",
      "seed": 20261031,
