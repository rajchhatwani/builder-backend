{
  "spec_version": 1,
  "project": {
    "name": "Seed Demo",
    "slug": "seed-demo",
    "description": null,
    "db_engine": "postgres"
  },
  "entities": [
    {
      "name": "Customer",
      "table_name": "customers",
      "plural_path": "customers",
      "options": {
        "filterable": [
          "active"
        ],
        "sortable": [
          "name"
        ]
      },
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "max_length": 80
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "unique": true,
          "max_length": 120
        },
        {
          "name": "notes",
          "type": "text"
        },
        {
          "name": "active",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "name": "Invoice",
      "table_name": "invoices",
      "plural_path": "invoices",
      "options": {
        "filterable": [
          "status"
        ],
        "sortable": [
          "created_at"
        ]
      },
      "fields": [
        {
          "name": "invoice_no",
          "type": "string",
          "required": true,
          "unique": true,
          "max_length": 40
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "min_value": 0
        },
        {
          "name": "issued_on",
          "type": "date",
          "required": true
        },
        {
          "name": "memo",
          "type": "string",
          "max_length": 200
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum_values": [
            "draft",
            "submitted",
            "approved",
            "paid",
            "rejected"
          ]
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "one_to_many",
      "from_entity": "Customer",
      "to_entity": "Invoice",
      "from_name": "invoices",
      "to_name": "customer",
      "on_delete": "restrict",
      "required": true
    }
  ],
  "auth": {
    "enabled": true,
    "deletion_mode": "hard",
    "security_headers_enabled": false,
    "registration": {
      "email_verification_required": false
    },
    "roles": [
      {
        "name": "admin",
        "label": "Admin"
      },
      {
        "name": "approver",
        "label": "Approver"
      },
      {
        "name": "clerk",
        "label": "Clerk"
      }
    ],
    "permissions": [
      {
        "entity": "Customer",
        "operation": "create",
        "roles": [
          "clerk",
          "admin"
        ],
        "row_rule": "tenant"
      },
      {
        "entity": "Customer",
        "operation": "list",
        "roles": [
          "clerk",
          "approver",
