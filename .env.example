BUILDER_ENVIRONMENT=local
BUILDER_LOG_LEVEL=INFO
BUILDER_DATABASE_URL=postgresql+asyncpg://builder:builder@localhost:5432/builder
BUILDER_CORS_ORIGINS=["http://localhost:5173"]
# Signs sign-in tokens and encrypts stored SMTP / SMS credentials. Losing or changing it signs
# everyone out and makes stored credentials unreadable. Outside BUILDER_ENVIRONMENT=local it must
# be >= 32 random characters (`openssl rand -base64 48`). Read straight from the process environment.
SECRET_KEY=

# Accounts. See README "Accounts, administration and API tokens".
BUILDER_SIGNUP_MODE=open
# First administrator, applied once at startup when none exists (no default password on purpose):
# BUILDER_BOOTSTRAP_ADMIN_EMAIL=
# BUILDER_BOOTSTRAP_ADMIN_PASSWORD=

# Billing (Platform SaaS Phases B–C: Stripe Checkout, Billing Portal, webhook).
# Leave the key unset to hide online upgrades (checkout answers 503).
# BUILDER_STRIPE_SECRET_KEY=sk_test_...
# Plan id → Stripe Price id for plans sold online.
# BUILDER_STRIPE_PRICE_IDS={"team":"price_...","business":"price_..."}
# Where the browser app lives; Stripe sends customers back here after Checkout.
# BUILDER_PUBLIC_APP_URL=http://localhost:5173
# Signing secret of the Stripe webhook endpoint POST <api>/billing/stripe/webhook.
# Subscribe it to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed.
# During a secret roll, give both: whsec_old,whsec_new. Unset → the webhook answers 503.
# BUILDER_STRIPE_WEBHOOK_SECRET=whsec_...
# BUILDER_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Platform e-mail for org invitations (stdlib SMTP). Leave the host unset and admins copy the
# invite link from the UI instead.
# BUILDER_SMTP_HOST=smtp.example.com
# BUILDER_SMTP_PORT=587
# BUILDER_SMTP_USERNAME=
# BUILDER_SMTP_PASSWORD=
# BUILDER_SMTP_FROM=Backend Builder <no-reply@example.com>
# BUILDER_SMTP_STARTTLS=true

# Billing reconciliation (catches webhooks Stripe gave up on, ends platform trials).
# Run hourly from cron:  python -m app.services.billing_reconcile

# Org deletion: an owner's request locks the org now; it's deleted (with its projects) after
# this many days unless the owner revokes. Run the deletion job from cron, e.g. hourly:
#   python -m app.services.org_deletion_service
# BUILDER_ORG_DELETION_GRACE_DAYS=7

# -- Enterprise SSO (Phase D) ------------------------------------------------------------------
# The API's public base URL. SAML entity IDs (/sso/metadata/<slug>), the SAML ACS URL
# (/sso/saml/<slug>/acs) and the OIDC redirect URI (/sso/oidc/<slug>/callback) are built from it,
# so it must be the address the customer's IdP and browsers reach. BUILDER_PUBLIC_APP_URL is where
# a finished sign-in lands (#/sso/complete, or #/login?sso_error=<reason>).
# BUILDER_PUBLIC_API_URL=http://localhost:8000
# Allow OIDC discovery/token/JWKS URLs on private networks (a self-hosted IdP in your own VPC).
# Off by default: it is what stops SSRF through the org admin's SSO form.
# BUILDER_SSO_ALLOW_PRIVATE_IDP=false
# Allow plain-http IdP URLs (a local Keycloak on a laptop only). Never in production.
# BUILDER_SSO_ALLOW_HTTP_IDP=false
# How long a started SSO login may take at the IdP.
# BUILDER_SSO_LOGIN_TTL_SECONDS=600

# -- Two-factor authentication (built-in TOTP, §4.4) ---------------------------------------------
# Platform staff (admin and support) must use TOTP at every sign-in; a staff account without it is
# asked to set it up at its next sign-in. Set false only for local development.
# BUILDER_ADMIN_MFA_REQUIRED=true
# How long the "enter your code" step may take after the password was accepted.
# BUILDER_MFA_CHALLENGE_SECONDS=300
# The name authenticator apps show next to the account.
# BUILDER_TOTP_ISSUER=Builder
