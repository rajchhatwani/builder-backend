BUILDER_ENVIRONMENT=local
BUILDER_LOG_LEVEL=INFO
BUILDER_DATABASE_URL=postgresql+asyncpg://builder:builder@localhost:5432/builder
BUILDER_CORS_ORIGINS=["http://localhost:5173"]
# Encrypts stored SMTP / SMS credentials (any long random string; losing it makes them unreadable).
# Read straight from the process environment, so export it or let docker compose pass it through.
SECRET_KEY=
