# Copy to /opt/builder/.env on the server (chmod 600). Secrets live ONLY here, never in GitHub or git.
# Generate each secret with: openssl rand -hex 32
BB_IMAGE_PREFIX=ghcr.io/<github-owner-lowercase>
BB_DOMAIN=app.example.com
KC_DOMAIN=login.example.com
ACME_EMAIL=you@example.com

SECRET_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# closed = only invited users and the bootstrap admin; open = anyone can register
BB_SIGNUP_MODE=closed
BB_BOOTSTRAP_ADMIN_EMAIL=
BB_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: e-mail (verification, notifications) and the platform AI key
BB_SMTP_HOST=
BB_SMTP_PORT=587
BB_SMTP_USERNAME=
BB_SMTP_PASSWORD=
BB_SMTP_FROM=
BB_AI_API_KEY=
BB_AI_PLATFORM_KEY_ORGS=[]
# Optional: Stripe billing (test or live keys). If you set the secret key, set all three; leave all three
# lines out of .env (do not leave them empty) when billing is off. Webhook: POST https://<BB_DOMAIN>/billing/stripe/webhook
# BB_STRIPE_SECRET_KEY=sk_test_...
# BB_STRIPE_WEBHOOK_SECRET=whsec_...
# BB_STRIPE_PRICE_IDS='{"team":"price_..."}'

# --- Previews and the builder-agent sandbox (optional; off unless SANDBOX_ENABLED=true) ---
# Needs host setup first: docs/DEPLOY.md "Previews and the agent sandbox".
SANDBOX_ENABLED=false
PREVIEW_DOMAIN=preview.example.com
BB_DATA=/var/lib/builder
BB_RUNNER_TOKEN=
BB_SANDBOX_RUNTIME=runsc
