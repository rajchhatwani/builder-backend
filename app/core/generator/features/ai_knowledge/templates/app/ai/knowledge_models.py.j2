"""Knowledge library tables (generated). A source carries its OWN visibility (`allowed_roles`, or `owner_only`); its chunks
are searched with that visibility applied in SQL. `tsv` is a generated full-text column; `embedding` is the deterministic
fake embedding (see app/ai/knowledge_service.py, adapter interface)."""

import datetime as _dt
import uuid as _uuid

import sqlalchemy as _sa
from sqlalchemy import orm as _orm
from sqlalchemy.dialects import postgresql as _pg

from app.models import _base as _models_base


def _id() -> _orm.Mapped[_uuid.UUID]:
    return _orm.mapped_column(
        _sa.Uuid(), primary_key=True, default=_uuid.uuid4, server_default=_sa.text("gen_random_uuid()")
    )


def _created() -> _orm.Mapped[_dt.datetime]:
    return _orm.mapped_column(
        _sa.DateTime(timezone=True), nullable=False, default=_models_base.utcnow, server_default=_sa.text("now()")
    )

