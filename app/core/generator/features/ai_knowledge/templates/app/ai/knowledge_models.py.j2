{% if tenant %}
    tenant_id: _orm.Mapped[_uuid.UUID] = _orm.mapped_column(
        _sa.ForeignKey("auth_tenants.id", name="fk_{{ table }}_tenant_id_auth_tenants", ondelete="RESTRICT"),
        nullable=False,
        index=True,
    )
{% endif %}
{% endmacro %}

class AiKnowledgeSource(_models_base.Base):
    __tablename__ = "ai_knowledge_sources"

    id: _orm.Mapped[_uuid.UUID] = _id()
{{ tenant_column("ai_knowledge_sources") }}
    title: _orm.Mapped[str] = _orm.mapped_column(_sa.String(200), nullable=False)
    owner_id: _orm.Mapped[_uuid.UUID] = _orm.mapped_column(_sa.Uuid(), nullable=False)
    owner_only: _orm.Mapped[bool] = _orm.mapped_column(_sa.Boolean(), nullable=False, default=False, server_default=_sa.false())
    allowed_roles: _orm.Mapped[list[str]] = _orm.mapped_column(
        _pg.ARRAY(_sa.Text()), nullable=False, default=list, server_default=_sa.text("'{}'::text[]")
    )
    chunk_count: _orm.Mapped[int] = _orm.mapped_column(_sa.Integer(), nullable=False, default=0, server_default="0")
    created_at: _orm.Mapped[_dt.datetime] = _created()

    __table_args__ = (
        _sa.CheckConstraint(
            "(owner_only AND cardinality(allowed_roles) = 0) OR (NOT owner_only AND cardinality(allowed_roles) > 0)",
            name="ck_ai_knowledge_sources_visibility",
        ),
        _sa.Index("ix_ai_knowledge_sources_owner_id", "owner_id"),
    )


class AiKnowledgeChunk(_models_base.Base):
    __tablename__ = "ai_knowledge_chunks"

    id: _orm.Mapped[_uuid.UUID] = _id()
{{ tenant_column("ai_knowledge_chunks") }}
    source_id: _orm.Mapped[_uuid.UUID] = _orm.mapped_column(
        _sa.ForeignKey("ai_knowledge_sources.id", name="fk_ai_knowledge_chunks_source_id_ai_knowledge_sources", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
