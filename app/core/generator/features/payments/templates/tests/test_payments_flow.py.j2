async def test_a_payment_for_an_item_changed_in_the_meantime_is_kept_but_flagged(
    client: AsyncClient, payments_env: FakeProvider
) -> None:
    """Money was taken, so the payment is recorded; the item is not silently overwritten."""
    headers, order_id = await customer_and_order(client)
    async with client_for(headers) as customer:
        created = (await pay(customer, order_id)).json()
    async with session_factory() as session:  # someone moves the item on while the payer is paying
        await session.execute(
            sa.update({{ payable.model }})
            .where({{ payable.model }}.id == uuid.UUID(order_id))
            .values({"{{ payable.status_field }}": "{{ other_status }}"})
        )
        await session.commit()
    session_id = payments_env.only_session_id()
    payments_env.pay(session_id)
    assert (await deliver(client, payments_env.completed_event(session_id))).status_code == 200
    async with session_factory() as session:
        payment = await session.get(Payment, uuid.UUID(created["id"]))
        events_seen = (
            await session.execute(select(AuditLog.event).where(AuditLog.chain_key == created["id"]))
        ).scalars().all()
    assert payment is not None and payment.status == "succeeded"
    assert "payable_status_conflict" in events_seen
    assert await order_status(order_id) == "{{ other_status }}"  # left as the humans set it


