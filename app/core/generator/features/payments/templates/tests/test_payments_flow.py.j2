# --- the two-person rule -------------------------------------------------------------------------


THRESHOLD = {{ p.refund_approval_threshold_minor }}


async def test_a_large_refund_needs_a_second_person(
    client: AsyncClient, payments_env: FakeProvider
) -> None:
    headers, order_id = await customer_and_order(client)
    await set_order_amount(order_id, THRESHOLD + 100)  # over the threshold
    payment_id = await finished_payment(client, payments_env, headers, order_id)
    requester = await sign_in(client, "requester@example.com", roles=role("refund"), n=1, join=CUSTOMER)
    approver = await sign_in(client, "approver@example.com", roles=role("approve_refund"), n=2, join=CUSTOMER)
    async with client_for(requester) as asking, client_for(approver) as deciding:
        asked = await asking.post(
            f"/payments/{payment_id}/refunds", json={}, headers={"Idempotency-Key": "refund-key-1"}
        )
        assert asked.status_code == 201 and asked.json()["status"] == "pending_approval"
        assert payments_env.refunds == {}  # nothing is sent before approval
        refund_id = asked.json()["id"]

        not_allowed = await asking.post(f"/payments/refunds/{refund_id}/approve")
        assert not_allowed.status_code == 403  # the requester does not hold the approver role
        assert payments_env.refunds == {}

        approved = await deciding.post(f"/payments/refunds/{refund_id}/approve")
        assert approved.status_code == 200, approved.text
        assert approved.json()["status"] == "succeeded"
        assert approved.json()["approved_by_id"] != approved.json()["requested_by_id"]
    assert len(payments_env.refunds) == 1


async def test_a_rejected_refund_frees_the_amount(
    client: AsyncClient, payments_env: FakeProvider
) -> None:
    headers, order_id = await customer_and_order(client)
    await set_order_amount(order_id, THRESHOLD + 100)
    payment_id = await finished_payment(client, payments_env, headers, order_id)
    requester = await sign_in(client, "requester@example.com", roles=role("refund"), n=1, join=CUSTOMER)
    approver = await sign_in(client, "approver@example.com", roles=role("approve_refund"), n=2, join=CUSTOMER)
    async with client_for(requester) as asking, client_for(approver) as deciding:
        asked = await asking.post(
            f"/payments/{payment_id}/refunds", json={}, headers={"Idempotency-Key": "refund-key-1"}
        )
        rejected = await deciding.post(f"/payments/refunds/{asked.json()['id']}/reject")
        assert rejected.json()["status"] == "rejected"
        again = await asking.post(
            f"/payments/{payment_id}/refunds", json={}, headers={"Idempotency-Key": "refund-key-2"}
        )
        assert again.status_code == 201
    assert payments_env.refunds == {}


async def test_nobody_approves_their_own_refund(
    client: AsyncClient, payments_env: FakeProvider
) -> None:
    both = set(config.ROLES["refund"]) & set(config.ROLES["approve_refund"])
    if not both:
        pytest.skip("no role can both request and approve refunds in this project")
    headers, order_id = await customer_and_order(client)
    await set_order_amount(order_id, THRESHOLD + 100)
    payment_id = await finished_payment(client, payments_env, headers, order_id)
    both_roles = await sign_in(client, "both@example.com", roles=[sorted(both)[0]], n=1, join=CUSTOMER)
    async with client_for(both_roles) as http:
        asked = await http.post(
            f"/payments/{payment_id}/refunds", json={}, headers={"Idempotency-Key": "refund-key-1"}
        )
        assert asked.json()["status"] == "pending_approval"
        own = await http.post(f"/payments/refunds/{asked.json()['id']}/approve")
    assert own.status_code == 403
    assert own.json()["code"] == "cannot_approve_own_refund"
    assert payments_env.refunds == {}
