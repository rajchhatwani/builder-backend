-- Least-privilege database logins for the payments module (generated).
--
-- Three logins instead of one all-powerful one:
--   {{ slug_sql }}_migrator  owns the tables and runs migrations. Used only at deploy time.
--   {{ slug_sql }}_app       used by the API and the workers. Can read and write data, cannot change
--                      the schema, and can only ever append to the audit log.
--
-- Run it once as the database administrator, with the passwords passed on the command line (never
-- written into this file or committed):
--
--   psql "$ADMIN_DATABASE_URL" \
--        -v migrator_password="$(openssl rand -base64 32)" -v app_password="$(openssl rand -base64 32)" \
--        -v database={{ slug_sql }} -f roles.sql
--
-- Then deploy with DATABASE_URL pointing at the _app login, and give the migration step (the
-- Kubernetes migrate Job, or `alembic upgrade head` run by hand) the _migrator login.
--
-- If the schema already exists (created by another login), hand ownership to the migrator login
-- first:  ALTER TABLE <each table> OWNER TO {{ slug_sql }}_migrator;

SELECT format('CREATE ROLE {{ slug_sql }}_migrator LOGIN PASSWORD %L', :'migrator_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ slug_sql }}_migrator')\gexec
SELECT format('CREATE ROLE {{ slug_sql }}_app LOGIN PASSWORD %L', :'app_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ slug_sql }}_app')\gexec

GRANT CONNECT ON DATABASE :"database" TO {{ slug_sql }}_migrator, {{ slug_sql }}_app;
GRANT USAGE ON SCHEMA public TO {{ slug_sql }}_app;
GRANT USAGE, CREATE ON SCHEMA public TO {{ slug_sql }}_migrator;

-- Tables created from now on by the migrator are usable by the app login automatically.
ALTER DEFAULT PRIVILEGES FOR ROLE {{ slug_sql }}_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {{ slug_sql }}_app;
ALTER DEFAULT PRIVILEGES FOR ROLE {{ slug_sql }}_migrator IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO {{ slug_sql }}_app;

-- Tables that already exist.
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO {{ slug_sql }}_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO {{ slug_sql }}_app;

-- The audit trail is append-only for the app, whatever else happens (a trigger enforces this too).
REVOKE UPDATE, DELETE, TRUNCATE ON pay_audit_log FROM {{ slug_sql }}_app;
