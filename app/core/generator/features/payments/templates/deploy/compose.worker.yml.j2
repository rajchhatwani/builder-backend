# Payments workers on a machine of their own (generated).
#
# A worker needs only the database and the payment provider: it does not talk to the API or to
# other workers, so you can run as many of these as the load needs, on as many machines as you
# like. Build the image once, push it to a registry your servers can pull from, then on each server:
#
#   export APP_IMAGE=registry.example.com/{{ slug }}:1.0.0
#   docker compose -f compose.worker.yml up -d
#
# Put the settings below in a .env file next to this one (see ../.env.example). Never put real
# secrets in this file, and never commit the .env file.
services:
  payments-worker:
    image: ${APP_IMAGE:?set APP_IMAGE to the image you built and pushed}
    command: ["python", "-m", "app.payments.worker"]
    restart: unless-stopped
    environment:
      # The worker's own database login (see sql/roles.sql). Use TLS to reach a database on
      # another machine: add ?ssl=require (asyncpg) to the URL, and prefer verify-full.
      DATABASE_URL: ${DATABASE_URL:?set DATABASE_URL}
      APP_ENV: ${APP_ENV:-production}
{% for name in prov.key_envs + (prov.webhook_secret_env,) %}
      {{ name }}: ${ {{- name }}:?set {{ name }}}
{% endfor %}
{% if kc %}
      KEYCLOAK_PUBLIC_URL: ${KEYCLOAK_PUBLIC_URL:?set KEYCLOAK_PUBLIC_URL}
      KEYCLOAK_INTERNAL_URL: ${KEYCLOAK_INTERNAL_URL:-}
{% endif %}
      PAYMENTS_WORKER_CONCURRENCY: ${PAYMENTS_WORKER_CONCURRENCY:-{{ sizing.worker_concurrency }}}
      PAYMENTS_POLL_INTERVAL_SECONDS: ${PAYMENTS_POLL_INTERVAL_SECONDS:-{{ sizing.poll_interval_seconds }}}
      PAYMENTS_SCHEDULER: ${PAYMENTS_SCHEDULER:-true}
      DB_POOL_SIZE: ${DB_POOL_SIZE:-{{ sizing.worker_pool_size }}}
      DB_MAX_OVERFLOW: ${DB_MAX_OVERFLOW:-0}
{% if p.scale.pgbouncer %}
      DB_PGBOUNCER: ${DB_PGBOUNCER:-true}
{% endif %}
    deploy:
      replicas: ${WORKER_REPLICAS:-{{ sizing.worker_replicas }}}
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    stop_grace_period: 40s
