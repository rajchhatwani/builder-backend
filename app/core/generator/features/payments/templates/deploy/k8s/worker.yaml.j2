# Payments workers (generated). Run the queue and the periodic jobs; they need only the database
# and the provider. Add replicas freely: every job runs on exactly one worker at a time.
#
# Autoscaling on queue depth needs an external metric (for example KEDA with a Postgres scaler on
#   SELECT count(*) FROM pay_jobs WHERE status = 'queued' AND run_at <= now() ).
# GET /payments/ops/status reports the same numbers. Until you add one, scale by hand or on CPU.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ slug }}-payments-worker
  labels: {app: {{ slug }}, component: payments-worker}
spec:
  replicas: {{ sizing.worker_replicas }}
  selector:
    matchLabels: {app: {{ slug }}, component: payments-worker}
  template:
    metadata:
      labels: {app: {{ slug }}, component: payments-worker}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 40
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: {app: {{ slug }}, component: payments-worker}
      containers:
        - name: worker
          image: {{ slug }}
          command: ["python", "-m", "app.payments.worker"]
          envFrom:
            - secretRef: {name: {{ slug }}-payments}
          env:
            - {name: APP_ENV, value: production}
            - {name: PAYMENTS_WORKER_CONCURRENCY, value: "{{ sizing.worker_concurrency }}"}
            - {name: PAYMENTS_POLL_INTERVAL_SECONDS, value: "{{ sizing.poll_interval_seconds }}"}
            - {name: DB_POOL_SIZE, value: "{{ sizing.worker_pool_size }}"}
            - {name: DB_MAX_OVERFLOW, value: "0"}
{% if p.scale.pgbouncer %}
            - {name: DB_PGBOUNCER, value: "true"}
{% endif %}
          resources:
            requests: {cpu: 100m, memory: 192Mi}
            limits: {memory: 384Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
      volumes:
        - {name: tmp, emptyDir: {}}
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ slug }}-payments-worker
spec:
  scaleTargetRef: {apiVersion: apps/v1, kind: Deployment, name: {{ slug }}-payments-worker}
  minReplicas: {{ sizing.worker_replicas }}
  maxReplicas: {{ sizing.worker_replicas_max }}
  metrics:
    - type: Resource
      resource: {name: cpu, target: {type: Utilization, averageUtilization: 70}}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ slug }}-payments-worker
spec:
  maxUnavailable: 1
  selector:
    matchLabels: {app: {{ slug }}, component: payments-worker}
