"""Application entry point (generated)."""

import importlib
import pkgutil
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app import custom_routers
{% if api_edge %}
from app.api_edge.install import install as install_api_edge
{% endif %}
{% if auth %}
{% if auth.provider == "keycloak" %}
from app.auth.config import DOCS_CLIENT_ID, get_auth_settings
{% else %}
from app.auth.config import get_auth_settings
{% endif %}
{% if auth.security_headers_enabled %}
from app.auth.middleware import SecurityHeadersMiddleware
{% endif %}
from app.auth.provider_lock import ensure_provider_lock
from app.auth.router import router as _auth_router
{% endif %}
{% if history_router %}
from app.change_history.router import router as _change_history_router
{% endif %}
from app.config import get_settings
{% if observability %}
from app.core import telemetry
{% endif %}
from app.core.errors import register_exception_handlers
from app.core.logging import RequestIdMiddleware, configure_logging
from app.db import engine
{% if documents %}
from app.documents.router import router as _documents_router
{% endif %}
{% if events %}
from app.events.relay import start_relay, stop_relay
{% endif %}
{% if notifications %}
from app.notifications.dispatcher import start_dispatcher, stop_dispatcher
from app.notifications.router import router as _notifications_router
{% endif %}
{% if payments %}
from app.payments.lock import ensure_payments_lock
from app.payments.router import router as _payments_router
{% endif %}
{% if providers %}
from app.providers import config as _providers_config
from app.providers.router import router as _providers_router
{% endif %}
from app.routers._health import router as _health_router
{% for e in entities %}
from app.routers.{{ e.table }} import router as {{ e.table }}_router
{% endfor %}
{% if runtime_router %}
from app.runtime_config.router import router as _runtime_config_router
{% endif %}
{% if state_machines %}
from app.state_machines.router import router as _state_machines_router
{% endif %}
{% if storage %}
from app.storage import config as _storage_config
from app.storage.backend import prepare_bucket
from app.storage.limits import UploadSizeLimitMiddleware
from app.storage.router import router as _storage_router
{% endif %}
{% if webhooks %}
from app.webhooks.router import public_router as _webhooks_public_router
from app.webhooks.router import router as _webhooks_router
{% endif %}
{% if workflows %}
from app.workflows.router import router as _workflows_router
{% endif %}


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncIterator[None]:
{% if auth %}
    get_auth_settings()  # a missing secret stops the app here, with a clear message
    await ensure_provider_lock()  # refuses to start on a database used by another provider
{% endif %}
{% if payments %}
    await ensure_payments_lock()  # unsafe or missing payment settings stop the app here
{% endif %}
{% if providers %}
    _providers_config.check_boot()  # production refuses a missing, short or placeholder PROVIDER_VAULT_KEY
{% endif %}
{% if storage %}
    _storage_config.get_storage_settings().check()  # unsafe or missing storage settings stop the app here
    await prepare_bucket()  # development only: create the bucket when asked to
{% endif %}
{% if events or notifications %}
{% if events %}
    relay = start_relay()  # delivers outbox events; EVENTS_RELAY_ENABLED=false leaves it to `python -m app.events.relay`
{% endif %}
{% if notifications %}
    dispatcher = start_dispatcher()  # sends queued notifications; NOTIFICATIONS_DISPATCHER_ENABLED=false leaves it to `python -m app.notifications.dispatcher`
{% endif %}
    try:
        yield
    finally:
{% if notifications %}
        await stop_dispatcher(dispatcher)
{% endif %}
{% if events %}
        await stop_relay(relay)
{% endif %}
{% else %}
    yield
{% endif %}
{% if observability %}
    telemetry.shutdown()  # flush what has not been exported yet
{% endif %}
    await engine.dispose()


def include_custom_routers(app: FastAPI) -> None:
    """Mount every module in app/custom_routers that defines a `router`."""
    for module_info in sorted(pkgutil.iter_modules(custom_routers.__path__), key=lambda m: m.name):
        module = importlib.import_module(f"{custom_routers.__name__}.{module_info.name}")
        router = getattr(module, "router", None)
        if router is not None:
            app.include_router(router)


def create_app() -> FastAPI:
    settings = get_settings()
    configure_logging(settings.log_level)

{% if auth and auth.provider == "keycloak" %}
    app = FastAPI(
        title={{ name | pyrepr }},
        version="0.1.0",
        lifespan=lifespan,
        # The "Authorize" button in /docs signs in through Keycloak with PKCE (no secret).
        swagger_ui_init_oauth={
            "clientId": DOCS_CLIENT_ID,
            "usePkceWithAuthorizationCodeGrant": True,
            "scopes": "openid",
        },
    )
{% else %}
    app = FastAPI(title={{ name | pyrepr }}, version="0.1.0", lifespan=lifespan)
{% endif %}
{% if api_edge %}
    install_api_edge(app)  # idempotency, rate limits, API versions: before any router is included
{% endif %}
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_methods=["*"],
        allow_headers=["*"],
    )
{% if storage %}
    # Refuses an oversize upload as it arrives, before it is spooled to disk.
    app.add_middleware(
        UploadSizeLimitMiddleware, path="/files", max_file_bytes=_storage_config.MAX_FILE_BYTES
    )
{% endif %}
{% if auth and auth.security_headers_enabled %}
    app.add_middleware(SecurityHeadersMiddleware)
{% endif %}
    app.add_middleware(RequestIdMiddleware)
    register_exception_handlers(app)
{% if observability %}
    telemetry.setup(app)  # traces, metrics and log correlation; configured by OTEL_* variables
{% endif %}
    app.include_router(_health_router)
{% if auth %}
    app.include_router(_auth_router)
{% endif %}
{% if payments %}
    app.include_router(_payments_router)
{% endif %}
{% if storage %}
    app.include_router(_storage_router)
{% endif %}
{% if documents %}
    app.include_router(_documents_router)
{% endif %}
{% for e in entities %}
    app.include_router({{ e.table }}_router)
{% endfor %}
{% if state_machines %}
    app.include_router(_state_machines_router)
{% endif %}
{% if providers %}
    app.include_router(_providers_router)
{% endif %}
{% if webhooks %}
    app.include_router(_webhooks_router)
    app.include_router(_webhooks_public_router)
{% endif %}
{% if notifications %}
    app.include_router(_notifications_router)
{% endif %}
{% if workflows %}
    app.include_router(_workflows_router)
{% endif %}
{% if runtime_router %}
    app.include_router(_runtime_config_router)
{% endif %}
{% if history_router %}
    app.include_router(_change_history_router)
{% endif %}
    include_custom_routers(app)
    return app


app = create_app()
