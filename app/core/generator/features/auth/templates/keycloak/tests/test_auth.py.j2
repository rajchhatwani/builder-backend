# --- erasure ----------------------------------------------------------------------------


async def test_deleting_the_account_erases_the_profile_and_blocks_the_user(
    client: AsyncClient,
) -> None:
    sub = uuid.uuid4()
    access = token(sub=sub, email="gone@example.com")
    assert (await client.get("/auth/me", headers=bearer(access))).status_code == 200

    assert (await client.delete("/auth/me", headers=bearer(access))).status_code == 204

    async with session_factory() as session:
        user = await session.get(AuthUser, sub)
    assert user is not None
    assert user.email is None and user.name is None and user.roles == []
    assert user.deleted_at is not None and user.is_active is False
    await assert_refused(client, access)


# --- signing keys -----------------------------------------------------------------------


async def test_keys_are_fetched_once_and_cached(client: AsyncClient, key_server: KeyServer) -> None:
    for _ in range(5):
        assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200
    assert key_server.calls == 1


async def test_forged_key_ids_cannot_hammer_keycloak(
    client: AsyncClient, key_server: KeyServer
) -> None:
    assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200
    key_server.calls = 0
    for i in range(20):
        await assert_refused(client, sign(claims(), header={"kid": f"forged-{i}"}))
    assert key_server.calls <= 1


async def test_a_rotated_key_is_picked_up(
    client: AsyncClient, key_server: KeyServer, monkeypatch: pytest.MonkeyPatch
) -> None:
    assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200
    new_key = support.other_key()
    key_server.keys["rotated"] = new_key.public_key()
    monkeypatch.setattr(config, "JWKS_MIN_REFETCH_SECONDS", 0)

    rotated = sign(claims(), key=new_key, header={"kid": "rotated"})

    assert (await me(client, rotated)).status_code == 200


async def test_cached_keys_survive_a_short_keycloak_outage(
    client: AsyncClient, key_server: KeyServer, monkeypatch: pytest.MonkeyPatch
) -> None:
    assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200
    monkeypatch.setattr(config, "JWKS_TTL_SECONDS", 0)  # expired, so a refresh is attempted
    monkeypatch.setattr(config, "JWKS_MIN_REFETCH_SECONDS", 0)
    key_server.down = True

    assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200


async def test_keys_that_are_too_old_fail_closed(
    client: AsyncClient, key_server: KeyServer, monkeypatch: pytest.MonkeyPatch
) -> None:
    assert (await client.get("/auth/me", headers=bearer(token()))).status_code == 200
    monkeypatch.setattr(config, "JWKS_TTL_SECONDS", 0)
    monkeypatch.setattr(config, "JWKS_MAX_STALE_SECONDS", 0)
    monkeypatch.setattr(config, "JWKS_MIN_REFETCH_SECONDS", 0)
    key_server.down = True

    response = await client.get("/auth/me", headers=bearer(token()))

    assert response.status_code == 503
    assert response.json()["code"] == "auth_unavailable"


async def test_no_keys_at_all_fails_closed(client: AsyncClient, key_server: KeyServer) -> None:
    key_server.down = True
    response = await client.get("/auth/me", headers=bearer(token()))
    assert response.status_code == 503


def test_unusable_keys_in_the_key_set_are_skipped() -> None:
    good = support._TEST_KEY.public_key().public_numbers()

    def b64(number: int) -> str:
        raw = number.to_bytes((number.bit_length() + 7) // 8, "big")
        return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")

    rsa_entry = {"kty": "RSA", "kid": "ok", "use": "sig", "n": b64(good.n), "e": b64(good.e)}
    document = {
        "keys": [
            rsa_entry,
            {**rsa_entry, "kid": "encryption", "use": "enc"},
            {**rsa_entry, "kid": "wrong-alg", "alg": "HS256"},
            {**rsa_entry, "kid": "ec", "kty": "EC"},
            {**rsa_entry, "kid": "tiny", "n": b64(2**512 + 1)},
            {**rsa_entry, "kid": None},
            {"kty": "RSA", "kid": "broken", "n": "!!!", "e": "AQAB"},
            "not an object",
        ]
    }

    assert set(oidc.parse_jwks(document)) == {"ok"}
    with pytest.raises(ValueError):
        oidc.parse_jwks({"nope": []})


# --- settings ---------------------------------------------------------------------------


def test_production_refuses_a_plain_http_issuer(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("APP_ENV", "production")
    monkeypatch.setenv("KEYCLOAK_PUBLIC_URL", "http://id.example.com")
    config.get_auth_settings.cache_clear()
    with pytest.raises(ValueError, match="https"):
        config.get_auth_settings()
    config.get_auth_settings.cache_clear()


@pytest.mark.parametrize("url", ["", "id.example.com", "ftp://id.example.com", "https://u:p@id.example.com", "https://id.example.com/?q=1"])
def test_the_keycloak_url_must_be_a_clean_http_url(
    monkeypatch: pytest.MonkeyPatch, url: str
) -> None:
    monkeypatch.setenv("KEYCLOAK_PUBLIC_URL", url)
    config.get_auth_settings.cache_clear()
    with pytest.raises(ValueError):
        config.get_auth_settings()
    config.get_auth_settings.cache_clear()


def test_issuer_and_key_url_are_built_from_the_settings(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("KEYCLOAK_PUBLIC_URL", "https://id.example.com/")
    monkeypatch.setenv("KEYCLOAK_INTERNAL_URL", "http://keycloak:8080")
    config.get_auth_settings.cache_clear()
    settings = config.get_auth_settings()
    assert settings.issuer == f"https://id.example.com/realms/{config.REALM}"
    assert settings.jwks_url == (
        f"http://keycloak:8080/realms/{config.REALM}/protocol/openid-connect/certs"
    )
    config.get_auth_settings.cache_clear()


def test_a_token_is_all_ascii_json() -> None:
    parts = token().split(".")
    assert len(parts) == 3
    assert json.loads(base64.urlsafe_b64decode(parts[0] + "==")).get("alg") == "RS256"
