{% endif %}
async def test_roles_this_project_does_not_define_are_ignored(client: AsyncClient) -> None:
    response = await client.get(
        "/auth/me", headers=bearer(token(roles=["superuser", "realm-admin"]))
    )

    assert response.status_code == 200
    assert set(response.json()["roles"]) == set(config.DEFAULT_ROLES)


async def test_roles_of_another_client_are_not_trusted(client: AsyncClient) -> None:
    payload = claims(roles=[])
    payload["resource_access"] = {"some-other-client": {"roles": list({{ all_roles }})}}
    payload["realm_access"] = {"roles": list({{ all_roles }})}

    response = await client.get("/auth/me", headers=bearer(sign(payload)))

    assert set(response.json()["roles"]) == set(config.DEFAULT_ROLES)


async def test_a_token_a_few_seconds_past_expiry_is_still_inside_the_leeway(
    client: AsyncClient,
) -> None:
    now = int(time.time())
    expired_just_now = sign(claims(exp=now - 5, iat=now - 300))
    assert (await me(client, expired_just_now)).status_code == 200


async def test_audience_may_be_a_single_string(client: AsyncClient) -> None:
    access = sign(claims(aud=config.API_CLIENT_ID))
    assert (await me(client, access)).status_code == 200


# --- refused tokens ---------------------------------------------------------------------


async def test_no_token(client: AsyncClient) -> None:
    await assert_refused(client, None)


@pytest.mark.parametrize("junk", ["", "x", "a.b", "a.b.c", "...", "e30.e30.", "A" * 20000])
async def test_malformed_tokens(client: AsyncClient, junk: str) -> None:
    await assert_refused(client, junk)


async def test_other_authorization_schemes_are_ignored(client: AsyncClient) -> None:
    response = await client.get("/auth/me", headers={"Authorization": f"Basic {token()}"})
    assert response.status_code == 401


async def test_signed_by_someone_else(client: AsyncClient) -> None:
    await assert_refused(client, sign(claims(), key=support.other_key()))


async def test_tampered_payload(client: AsyncClient) -> None:
    head, _, signature = token(roles=[]).split(".")
    forged = support._json(claims(roles=list({{ all_roles }}) or ["admin"]))
    await assert_refused(client, f"{head}.{forged}.{signature}")


async def test_algorithm_none(client: AsyncClient) -> None:
    head = support._json({"alg": "none", "typ": "JWT", "kid": support.KID})
    await assert_refused(client, f"{head}.{support._json(claims())}.")


@pytest.mark.parametrize("alg", ["HS256", "HS384", "RS384", "PS256", "ES256", "none", "", None])
async def test_only_rs256_is_accepted(client: AsyncClient, alg: str | None) -> None:
    await assert_refused(client, sign(claims(), header={"alg": alg}))


async def test_hmac_signed_with_the_public_key_is_refused(client: AsyncClient) -> None:
    """The classic algorithm-confusion forgery: HS256 using the public key as the secret."""
    head = support._json({"alg": "HS256", "typ": "JWT", "kid": support.KID})
    body = support._json(claims())
    mac = hmac.new(support.public_pem(), f"{head}.{body}".encode("ascii"), hashlib.sha256)
    signature = base64.urlsafe_b64encode(mac.digest()).rstrip(b"=").decode("ascii")
    await assert_refused(client, f"{head}.{body}.{signature}")


async def test_keys_named_in_the_token_are_never_used(client: AsyncClient) -> None:
    """jwk / jku headers point at keys the attacker controls; they must be ignored."""
    attacker = support.other_key()
    jwk = {"kty": "RSA", "n": "AQAB", "e": "AQAB"}
    forged = sign(
        claims(),
        key=attacker,
        header={"jwk": jwk, "jku": "https://evil.example/keys", "kid": "attacker"},
    )
    await assert_refused(client, forged)


async def test_missing_or_unknown_key_id(client: AsyncClient) -> None:
    await assert_refused(client, sign(claims(), header={"kid": None}))
    await assert_refused(client, sign(claims(), header={"kid": "nope"}))
    await assert_refused(client, sign(claims(), header={"kid": ""}))


@pytest.mark.parametrize(
    "overrides",
    [
        {"iss": "https://evil.example/realms/x"},
        {"iss": None},
        {"aud": "some-other-client"},
        {"aud": ["a", "b"]},
        {"aud": None},
        {"aud": []},
        {"typ": "ID"},
        {"typ": "Refresh"},
        {"typ": None},
        {"exp": 1},
        {"exp": None},
        {"exp": "tomorrow"},
        {"exp": True},
        {"nbf": int(time.time()) + 3600},
        {"iat": int(time.time()) + 3600},
        {"sub": "x" * 256},
    ],
)
async def test_claims_that_are_wrong(client: AsyncClient, overrides: dict[str, object]) -> None:
    await assert_refused(client, sign(claims(**overrides)))


async def test_a_token_whose_subject_is_not_text_is_refused(client: AsyncClient) -> None:
    for subject in (12345, ["a"], {"a": 1}, True):
        payload = claims()
        payload["sub"] = subject
        await assert_refused(client, sign(payload))


async def test_a_token_without_a_subject_is_refused(client: AsyncClient) -> None:
    payload = claims()
    del payload["sub"]
    await assert_refused(client, sign(payload))


async def test_a_token_from_another_realm_is_refused(client: AsyncClient) -> None:
    other = f"{support.issuer().rsplit('/', 1)[0]}/other-realm"
    await assert_refused(client, sign(claims(iss=other)))


async def test_a_token_for_another_platform_on_the_same_realm_is_refused(
    client: AsyncClient,
) -> None:
    """Single sign-on shares the realm; the audience keeps each project's API separate."""
    await assert_refused(client, sign(claims(aud=["another-project-api"])))


async def test_a_deactivated_user_is_refused(client: AsyncClient) -> None:
    sub = uuid.uuid4()
    assert (await client.get("/auth/me", headers=bearer(token(sub=sub)))).status_code == 200
    async with session_factory() as session:
        user = await session.get(AuthUser, sub)
        assert user is not None
        user.is_active = False
        await session.commit()

    await assert_refused(client, token(sub=sub))


