"""Tests for signing in with Keycloak tokens (generated).

Tokens are signed by a throwaway key that the app is told to trust (see tests/_auth_support.py).
Each forged or broken token must be refused with the same plain 401, whatever was wrong."""

import asyncio
import base64
import hashlib
import hmac
import json
import time
import uuid

import pytest
from httpx import AsyncClient, Response
from sqlalchemy import select

from app.auth import config, oidc
from app.auth.models import AuthUser
from app.db import session_factory
from tests import _auth_support as support
from tests._auth_support import KeyServer, bearer, claims, sign, token

pytestmark = pytest.mark.usefixtures("key_server")


async def me(client: AsyncClient, access_token: str | None) -> Response:
    headers = bearer(access_token) if access_token is not None else {}
    return await client.get("/auth/me", headers=headers)


async def assert_refused(client: AsyncClient, access_token: str | None) -> None:
    response = await me(client, access_token)
    assert response.status_code == 401, response.text
    body = response.json()
    assert body["code"] == "unauthorized"
    # The reason is only ever logged, so a caller cannot learn which check failed.
    assert body["message"] in ("authentication required", "invalid or expired access token")


# --- accepted tokens --------------------------------------------------------------------


async def test_a_valid_token_signs_the_user_in(client: AsyncClient) -> None:
    response = await client.get("/auth/me", headers=bearer(token()))

    assert response.status_code == 200, response.text
    body = response.json()
    assert body["email"] == support.EMAIL
    assert body["name"] == "Test User"
    assert set(body["roles"]) == set(config.DEFAULT_ROLES)


async def test_the_profile_row_is_created_once_from_the_subject(client: AsyncClient) -> None:
    sub = uuid.uuid4()
    for _ in range(3):
        response = await client.get("/auth/me", headers=bearer(token(sub=sub)))
        assert response.status_code == 200
        assert response.json()["id"] == str(sub)
    async with session_factory() as session:
        rows = (await session.execute(select(AuthUser).where(AuthUser.id == sub))).scalars().all()
    assert len(rows) == 1


async def test_two_first_requests_at_once_create_one_row(client: AsyncClient) -> None:
    sub = uuid.uuid4()
    results = await asyncio.gather(
        *(client.get("/auth/me", headers=bearer(token(sub=sub))) for _ in range(5))
    )
    assert {r.status_code for r in results} == {200}


async def test_name_and_email_follow_keycloak(client: AsyncClient) -> None:
    sub = uuid.uuid4()
    await client.get("/auth/me", headers=bearer(token(email="old@example.com", sub=sub)))

    response = await client.get(
        "/auth/me", headers=bearer(token(email="new@example.com", sub=sub, name="New Name"))
    )

    assert response.json()["email"] == "new@example.com"
    assert response.json()["name"] == "New Name"


async def test_a_token_without_an_email_does_not_erase_the_known_one(
    client: AsyncClient,
) -> None:
    sub = uuid.uuid4()
    await client.get("/auth/me", headers=bearer(token(email="keep@example.com", sub=sub)))

    response = await client.get(
        "/auth/me", headers=bearer(sign(claims(sub=sub, email=None, email_verified=True)))
    )

    assert response.status_code == 200
    assert response.json()["email"] == "keep@example.com"


{% if all_roles != "()" %}
async def test_roles_come_from_the_token_and_can_change(client: AsyncClient) -> None:
    sub = uuid.uuid4()
    role = {{ all_roles }}[0]
    granted = await client.get("/auth/me", headers=bearer(token(sub=sub, roles=[role])))
    assert role in granted.json()["roles"]

    revoked = await client.get("/auth/me", headers=bearer(token(sub=sub, roles=[])))
