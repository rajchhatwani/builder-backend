async def test_{{ g.table }}_cannot_point_at_another_tenants_{{ fk.target_table }}(
    client: AsyncClient,
) -> None:
    a_headers = await sign_in(client, "a@example.com", roles=list(ALL_ROLES))
    b_headers = await sign_in(client, "b@example.com", roles=list(ALL_ROLES), n=1)
    async with client_for(a_headers) as tenant_a, client_for(b_headers) as tenant_b:
        foreign = await _factories.make_{{ fk.target_table }}(tenant_b)
        own = await _factories.make_{{ fk.target_table }}(tenant_a)
        payload = await _factories.payload_{{ g.table }}(tenant_a, {{ fk.column }}=own["id"])

        foreign_ref = {"{{ fk.column }}": foreign["id"]}

        refused = await tenant_a.post("/{{ g.path }}", json={**payload, **foreign_ref})
        assert refused.status_code == 422, refused.text
        assert refused.json()["code"] == "invalid_reference"

        created = await tenant_a.post("/{{ g.path }}", json=payload)
        assert created.status_code == 201, created.text
        item_id = created.json()["id"]
{% if "update" in ops %}

        moved = await tenant_a.patch(f"/{{ g.path }}/{item_id}", json=foreign_ref)
        assert moved.status_code == 422, moved.text
        assert moved.json()["code"] == "invalid_reference"
{% endif %}
{% if "replace" in ops %}

        replaced = await tenant_a.put(f"/{{ g.path }}/{item_id}", json={**payload, **foreign_ref})
        assert replaced.status_code == 422, replaced.text
{% endif %}
{% endfor %}
{% endfor %}
