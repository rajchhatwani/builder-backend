        assert refused.status_code == 422, refused.text
        assert refused.json()["code"] == "invalid_reference"

        linked = await tenant_a.post("/{{ g.path }}", json={**payload, "{{ link.key }}": [own["id"]]})
        assert linked.status_code == 201, linked.text
