async def test_{{ g.table }}_rows_stay_inside_their_tenant(client: AsyncClient) -> None:
    a_headers = await sign_in(client, "a@example.com", roles=list(ALL_ROLES))
    b_headers = await sign_in(client, "b@example.com", roles=list(ALL_ROLES), n=1)
{% if not g.owned %}
    colleague_headers = await sign_in(
        client, "colleague@example.com", roles=list(ALL_ROLES), n=2, join="a@example.com"
    )
{% endif %}
    async with (
        client_for(a_headers) as tenant_a,
        client_for(b_headers) as tenant_b,
{% if not g.owned %}
        client_for(colleague_headers) as colleague,
{% endif %}
    ):
        created = await _factories.make_{{ g.table }}(tenant_a)
        item_id = created["id"]

        me = (await tenant_a.get("/auth/me")).json()
        async with session_factory() as session:
            stamped = (
                await session.execute(
                    select({{ g.name }}.tenant_id).where({{ g.name }}.id == uuid.UUID(item_id))
                )
            ).scalar_one()
        assert str(stamped) == me["tenant_id"], "new rows are stamped with the creator's tenant"
{% if "list" in ops %}

        assert (await tenant_b.get("/{{ g.path }}")).json()["total"] == 0
{% if not g.owned %}
        assert (await colleague.get("/{{ g.path }}")).json()["total"] == 1
{% endif %}
{% endif %}
{% if "get" in ops %}

        assert (await tenant_b.get(f"/{{ g.path }}/{item_id}")).status_code == 404
{% if not g.owned %}
        assert (await colleague.get(f"/{{ g.path }}/{item_id}")).status_code == 200
{% endif %}
{% endif %}
{% if "head" in ops %}
        assert (await tenant_b.head(f"/{{ g.path }}/{item_id}")).status_code == 404
{% endif %}
{% if "delete" in ops %}

        assert (await tenant_b.delete(f"/{{ g.path }}/{item_id}")).status_code == 404
        assert (await tenant_a.delete(f"/{{ g.path }}/{item_id}")).status_code == 204
{% endif %}
