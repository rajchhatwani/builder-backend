{% set scoped = g.ops | selectattr("owner") | list %}


async def test_{{ g.table }}_rows_belong_to_their_creator(
    authed_client: AsyncClient, client: AsyncClient
) -> None:
    created = await _factories.make_{{ g.table }}(authed_client)
    item_id = created["id"]
    me = (await authed_client.get("/auth/me")).json()
    async with session_factory() as session:
        stamped = (
            await session.execute(
                select({{ g.name }}.created_by_id).where({{ g.name }}.id == uuid.UUID(item_id))
            )
        ).scalar_one()
    assert str(stamped) == me["id"]
{% if scoped %}

    # A second user who also holds every role: owner rules hide the row from them,
    # role_scoped rules let them see it because they hold the admin role.
    async with client_for(
        await sign_in(
            client,
            "second@example.com",
            roles=list(ALL_ROLES),
            n=1,
            join="all-roles@example.com",
        )
    ) as other:
{% for o in scoped if o.op == "list" %}
        listing = await other.get("/{{ g.path }}")
        assert listing.status_code == 200, listing.text
        assert listing.json()["total"] == {{ 1 if o.admin_sees_all else 0 }}
{% endfor %}
{% for o in scoped if o.op == "get" %}
        fetched = await other.get(f"/{{ g.path }}/{item_id}")
        assert fetched.status_code == {{ 200 if o.admin_sees_all else 404 }}, fetched.text
{% endfor %}
{% for o in scoped if o.op == "head" %}
        probed = await other.head(f"/{{ g.path }}/{item_id}")
        assert probed.status_code == {{ 200 if o.admin_sees_all else 404 }}
{% endfor %}
{% for o in scoped if o.op == "delete" %}
        removed = await other.delete(f"/{{ g.path }}/{item_id}")
        assert removed.status_code == {{ 204 if o.admin_sees_all else 404 }}, removed.text
{% if not o.admin_sees_all %}
        # The creator is unaffected by the refused attempt.
        assert (await authed_client.delete(f"/{{ g.path }}/{item_id}")).status_code == 204
{% endif %}
{% endfor %}
