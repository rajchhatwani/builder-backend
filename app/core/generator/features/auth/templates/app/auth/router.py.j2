from app.auth import config
from app.auth.delivery import Mailer, SmsSender, get_mailer, get_sms_sender
from app.auth.deps import CurrentUser{{ ", require_roles" if invitations else "" }}
{% if invitations %}
from app.auth.models import AuthUser
{% endif %}
from app.auth.ratelimit import RateLimiter
from app.auth.schemas import (
    Accepted,
    ChangePasswordRequest,
{% if sms_otp %}
    CodeRequest,
{% endif %}
    EmailRequest,
{% if invitations %}
    InvitationCreate,
    InvitationRead,
{% endif %}
    LoginRequest,
{% if magic_link or sms_otp %}
    PasswordResetConfirm,
    PasswordResetRequest,
{% endif %}
{% if sms_otp %}
    PhoneCodeRequest,
    PhoneRequest,
{% endif %}
    RefreshRequest,
    RegisterRequest,
{% if multi_tenant %}
    TenantRead,
{% endif %}
    TokenPair,
    TokenRequest,
    UserRead,
)
{% if rs256 %}
from app.auth.security import public_jwk
{% endif %}
from app.auth.service import AuthService
from app.db import SessionDep

router = _fa.APIRouter(prefix="/auth", tags=["auth"])

MailerDep = _t.Annotated[Mailer, _fa.Depends(get_mailer)]
SmsDep = _t.Annotated[SmsSender, _fa.Depends(get_sms_sender)]

_login_limit = RateLimiter("login", config.LOGIN_RATE_LIMIT)
_register_limit = RateLimiter("register", config.REGISTER_RATE_LIMIT)
_reset_limit = RateLimiter("reset", config.RESET_RATE_LIMIT)


async def _tokens(service: AuthService, user: _t.Any) -> TokenPair:
    access, refresh, expires_in = await service.issue_tokens(user)
    return TokenPair(access_token=access, refresh_token=refresh, expires_in=expires_in)


@router.post(
    "/register",
    response_model=UserRead,
    status_code=201,
    dependencies=[_fa.Depends(_register_limit)],
)
async def register(body: RegisterRequest, session: SessionDep, mailer: MailerDep) -> UserRead:
    user = await AuthService(session).register(body.model_dump(), mailer)
    return UserRead.model_validate(user)


@router.post("/login", response_model=TokenPair, dependencies=[_fa.Depends(_login_limit)])
async def login(body: LoginRequest, session: SessionDep) -> TokenPair:
    service = AuthService(session)
    user = await service.authenticate(body.email, body.password)
    return await _tokens(service, user)


@router.post("/refresh", response_model=TokenPair, dependencies=[_fa.Depends(_login_limit)])
async def refresh(body: RefreshRequest, session: SessionDep) -> TokenPair:
    access, new_refresh, expires_in = await AuthService(session).refresh(body.refresh_token)
    return TokenPair(access_token=access, refresh_token=new_refresh, expires_in=expires_in)


@router.post("/logout", status_code=204)
async def logout(body: RefreshRequest, session: SessionDep) -> None:
    """Revokes the refresh token and every token rotated from it."""
    await AuthService(session).logout(body.refresh_token)


{% if rs256 %}
@router.get("/jwks.json")
async def jwks() -> dict[str, list[dict[str, str]]]:
    """The public key that verifies access tokens, for services that only need to check them."""
    return {"keys": [public_jwk(config.get_auth_settings().jwt_key)]}


{% endif %}
@router.get("/me", response_model=UserRead)
async def me(user: CurrentUser) -> UserRead:
    return UserRead.model_validate(user)


{% if multi_tenant %}
@router.get("/tenant", response_model=TenantRead)
async def my_tenant(user: CurrentUser, session: SessionDep) -> TenantRead:
    """The tenant the signed-in user belongs to."""
    return TenantRead.model_validate(await AuthService(session).get_tenant(user))


{% endif %}
@router.delete("/me", status_code=204)
async def delete_me(user: CurrentUser, session: SessionDep) -> None:
{% if hard_delete %}
    """Permanently deletes the account and everything that belongs to it."""
{% else %}
    """Disables the account (soft delete): it can no longer sign in, but the row is kept."""
{% endif %}
    await AuthService(session).delete_account(user)


@router.post("/change-password", status_code=204)
async def change_password(
    body: ChangePasswordRequest, user: CurrentUser, session: SessionDep
) -> None:
    """Changes the password and signs the account out everywhere."""
    await AuthService(session).change_password(user, body.current_password, body.new_password)


{% if invitations %}
# --- invitations ------------------------------------------------------------------------

AdminDep = _t.Annotated[AuthUser, _fa.Depends(require_roles("admin"))]


@router.post("/invitations", response_model=InvitationRead, status_code=201)
async def create_invitation(
    body: InvitationCreate, admin: AdminDep, session: SessionDep, mailer: MailerDep
) -> InvitationRead:
    """Emails a link that lets one address register{{ ' (registration is invite-only)' if invite_only }}."""
    invitation = await AuthService(session).create_invitation(
        admin, body.email, list(body.roles), mailer
    )
    return InvitationRead.model_validate(invitation)


@router.get("/invitations", response_model=list[InvitationRead])
async def list_invitations(admin: AdminDep, session: SessionDep) -> list[InvitationRead]:
    """Invitations that are still waiting to be accepted{{ ' (your tenant only)' if multi_tenant }}."""
    invitations = await AuthService(session).list_invitations(admin)
    return [InvitationRead.model_validate(i) for i in invitations]


@router.delete("/invitations/{invitation_id}", status_code=204)
async def revoke_invitation(
    invitation_id: _uuid.UUID, admin: AdminDep, session: SessionDep
) -> None:
    await AuthService(session).revoke_invitation(admin, invitation_id)


{% endif %}
# --- email ------------------------------------------------------------------------------


@router.post("/email/verify", response_model=UserRead)
async def verify_email(body: TokenRequest, session: SessionDep) -> UserRead:
    user = await AuthService(session).verify_email(body.token)
    return UserRead.model_validate(user)


@router.post(
    "/email/resend-verification",
    response_model=Accepted,
    status_code=202,
    dependencies=[_fa.Depends(_reset_limit)],
)
async def resend_verification(body: EmailRequest, session: SessionDep, mailer: MailerDep) -> Accepted:
    await AuthService(session).resend_verification(body.email, mailer)
    return Accepted()
{% if magic_link %}


@router.post(
    "/magic-link/request",
    response_model=Accepted,
    status_code=202,
    dependencies=[_fa.Depends(_reset_limit)],
)
async def request_magic_link(body: EmailRequest, session: SessionDep, mailer: MailerDep) -> Accepted:
    """Emails a one-time sign-in link."""
    await AuthService(session).request_magic_link(body.email, mailer)
    return Accepted()


@router.post("/magic-link/consume", response_model=TokenPair, dependencies=[_fa.Depends(_login_limit)])
async def consume_magic_link(body: TokenRequest, session: SessionDep) -> TokenPair:
    service = AuthService(session)
    user = await service.consume_magic_link(body.token)
    return await _tokens(service, user)
{% endif %}
{% if sms_otp %}


# --- mobile -----------------------------------------------------------------------------


@router.post("/phone/verify/request", response_model=Accepted, status_code=202, dependencies=[_fa.Depends(_reset_limit)])
async def request_phone_verification(user: CurrentUser, session: SessionDep, sms: SmsDep) -> Accepted:
    """Texts a code to the phone number on the signed-in account."""
    await AuthService(session).request_phone_verification(user, sms)
    return Accepted()


@router.post("/phone/verify/confirm", response_model=UserRead)
async def confirm_phone_verification(body: CodeRequest, user: CurrentUser, session: SessionDep) -> UserRead:
    await AuthService(session).confirm_phone_verification(user, body.code)
    return UserRead.model_validate(user)


@router.post("/otp/request", response_model=Accepted, status_code=202, dependencies=[_fa.Depends(_reset_limit)])
async def request_otp(body: PhoneRequest, session: SessionDep, sms: SmsDep) -> Accepted:
    """Texts a sign-in code. Only phone numbers that were verified receive one."""
    await AuthService(session).request_sms_login(body.phone, sms)
    return Accepted()


@router.post("/otp/verify", response_model=TokenPair, dependencies=[_fa.Depends(_login_limit)])
async def verify_otp(body: PhoneCodeRequest, session: SessionDep) -> TokenPair:
    service = AuthService(session)
    user = await service.verify_sms_login(body.phone, body.code)
    return await _tokens(service, user)
{% endif %}
{% if magic_link or sms_otp %}


# --- password reset ---------------------------------------------------------------------


@router.post(
    "/password-reset/request",
    response_model=Accepted,
    status_code=202,
    dependencies=[_fa.Depends(_reset_limit)],
)
async def request_password_reset(
    body: PasswordResetRequest, session: SessionDep, mailer: MailerDep, sms: SmsDep
) -> Accepted:
    """Sends a reset link by email, or a code by SMS, to the account named in the body."""
    await AuthService(session).request_password_reset(body.email, body.phone, mailer, sms)
    return Accepted()


@router.post("/password-reset/confirm", status_code=204, dependencies=[_fa.Depends(_reset_limit)])
async def confirm_password_reset(body: PasswordResetConfirm, session: SessionDep) -> None:
    """Sets a new password and signs the account out everywhere."""
    await AuthService(session).confirm_password_reset(
        body.new_password, body.token, body.phone, body.code
    )
