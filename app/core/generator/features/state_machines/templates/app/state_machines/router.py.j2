"""Transition routes for entities with a state machine (generated)."""

import datetime as _dt
import uuid as _uuid
{% if auth %}
from typing import Annotated
{% endif %}

from fastapi import APIRouter{{ ", Depends" if auth else "" }}
from pydantic import BaseModel

{% if auth %}
from app.auth import access as _access
{% if routes | selectattr("update_ops") | list %}
from app.auth.deps import CurrentUser
{% endif %}
from app.auth.service import effective_roles
{% if routes | selectattr("update_ops") | list %}
from app.core.errors import AppError
{% endif %}
{% endif %}
{% for r in routes %}
from app.crud.{{ r.e.table }} import {{ r.e.name }}Repository
{% endfor %}
from app.db import SessionDep
{% for r in routes if auth and r.access_op %}
from app.routers.{{ r.e.table }} import _ACCESS as _ACCESS_{{ r.e.table }}
{% endfor %}
{% for r in routes %}
from app.schemas.{{ r.e.table }} import {{ r.e.name }}Read
{% endfor %}
from app.state_machines import engine

router = APIRouter(tags=["state machines"])


class TransitionInfo(BaseModel):
    name: str
    to_state: str
    allowed: bool
    refused_because: str | None = None  # "role" or "guard"


class StateChange(BaseModel):
    model_config = {"from_attributes": True}

    transition: str
    from_state: str | None
    to_state: str
    actor_id: _uuid.UUID | None
    automatic: bool
    created_at: _dt.datetime
{% for r in routes %}
{% set e = r.e %}
{% if auth %}
{% if r.access_op %}
_access_{{ e.table }} = _ACCESS_{{ e.table }}["{{ r.access_op }}"]
{% if r.post_op != r.access_op %}
# A move changes the record: on policy entities the caller must pass the UPDATE decision as well.
_access_move_{{ e.table }} = _ACCESS_{{ e.table }}["{{ r.post_op }}"]
{% endif %}
{% else %}
_access_{{ e.table }} = _access.access_dependency({% if r.gated %}authenticate=True{% endif %})
{% endif %}
{% endif %}
{% for u in r.update_ops %}


async def _can_{{ u.op }}_{{ e.table }}({% if u.needs_user %}user: CurrentUser{% endif %}) -> _access.Access | AppError:
    """The entity's own {{ u.op }} access for this caller; a refusal is kept, not raised: only a transition
    with no `roles` needs it."""
    try:
        return await _ACCESS_{{ e.table }}["{{ u.op }}"]({% if u.needs_user %}user{% endif %})
    except AppError as refused:
        return refused
{% endfor %}


def _roles_{{ e.table }}({% if auth %}access: _access.Access{% endif %}) -> set[str]:
{% if auth %}
    return effective_roles(access.user.roles) if access.user is not None else set()
{% else %}
    return set()
{% endif %}


@router.get("/{{ e.path }}/{item_id}/transitions", response_model=list[TransitionInfo])
async def list_{{ e.table }}_transitions(
    item_id: _uuid.UUID,
    session: SessionDep,
{% if auth %}
    access: Annotated[_access.Access, Depends(_access_{{ e.table }})],
{% endif %}
) -> list[dict[str, object]]:
    item = await {{ e.name }}Repository(session{% if auth %}, **access.repo_kwargs{% endif %}).get(item_id)
{% if settings_guards %}
    await engine.prime_settings(session, item)
{% endif %}
    return engine.available("{{ e.name }}", item, _roles_{{ e.table }}({% if auth %}access{% endif %}))


@router.post("/{{ e.path }}/{item_id}/transitions/{name}", response_model={{ e.name }}Read)
async def apply_{{ e.table }}_transition(
    item_id: _uuid.UUID,
    name: str,
    session: SessionDep,
{% if auth %}
    access: Annotated[_access.Access, Depends(_access_{{ "move_" if r.post_op != r.access_op else "" }}{{ e.table }})],
{% for u in r.update_ops %}
    can_{{ u.op }}: Annotated[_access.Access | AppError, Depends(_can_{{ u.op }}_{{ e.table }})],
{% endfor %}
{% endif %}
) -> {{ e.name }}Read:
{% if auth and r.update_ops %}
    # No `roles` on the transition = anyone who may update this record: the entity's update access
    # (roles and row rules) must pass as well as the read access above. Listed roles keep the role check.
    wanted = next((x for x in engine.machine("{{ e.name }}")["transitions"] if x["name"] == name and not x["auto"]), None)
    if wanted is not None and not wanted["roles"]:
{% for u in r.update_ops %}
        if isinstance(can_{{ u.op }}, AppError):
            raise can_{{ u.op }}
        await {{ e.name }}Repository(session, **can_{{ u.op }}.repo_kwargs).get(item_id)
{% endfor %}
{% endif %}
    repo = {{ e.name }}Repository(session{% if auth %}, **access.repo_kwargs{% endif %})
    item = await engine.apply(
        repo,
        "{{ e.name }}",
        item_id,
        name,
        roles=_roles_{{ e.table }}({% if auth %}access{% endif %}),
        actor_id={% if auth %}access.user.id if access.user is not None else None{% else %}None{% endif %},
    )
    return {{ e.name }}Read.model_validate(item)


@router.get("/{{ e.path }}/{item_id}/state-history", response_model=list[StateChange])
async def {{ e.table }}_state_history(
    item_id: _uuid.UUID,
    session: SessionDep,
{% if auth %}
    access: Annotated[_access.Access, Depends(_access_{{ e.table }})],
{% endif %}
) -> list[StateChange]:
    await {{ e.name }}Repository(session{% if auth %}, **access.repo_kwargs{% endif %}).get(item_id)
    rows = await engine.history(session, "{{ e.name }}", item_id)
    return [StateChange.model_validate(row) for row in rows]
{% endfor %}
