async def test_metrics_use_the_route_template_not_the_raw_path(probes) -> None:  # noqa: ANN001
    for i in range(1, 15):
        await call(probes["app"], f"/items/{i}")  # type: ignore[arg-type]
    data = probes["reader"].get_metrics_data()  # type: ignore[attr-defined]
    values: set[str] = set()
    series = 0
    for resource_metrics in data.resource_metrics:
        for scope in resource_metrics.scope_metrics:
            for metric in scope.metrics:
                if "duration" not in metric.name:
                    continue
                for point in metric.data.data_points:
                    series += 1
                    values.update(str(v) for v in point.attributes.values())
    assert series >= 1
    assert series <= 2, "one series per route and status, not one per id"
    assert not any(v == "/items/7" or v.endswith("/items/7") for v in values)


async def test_denied_events_are_counted(probes) -> None:  # noqa: ANN001
    assert await call(probes["app"], "/denied") == 403  # type: ignore[arg-type]
    data = probes["reader"].get_metrics_data()  # type: ignore[attr-defined]
    found = [
        point
        for rm in data.resource_metrics
        for sm in rm.scope_metrics
        for metric in sm.metrics
        if metric.name == "app.authz.denied"
        for point in metric.data.data_points
    ]
    assert len(found) == 1
    assert found[0].value == 1
    assert dict(found[0].attributes) == {"entity": "Thing", "op": "get"}
