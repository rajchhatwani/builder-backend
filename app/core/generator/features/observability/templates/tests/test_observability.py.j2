async def test_sql_statements_become_spans_without_their_values(probes) -> None:  # noqa: ANN001
    import sqlalchemy as sa

    from app.db import engine

    spans = probes["spans"]
    async with engine.connect() as connection:
        await connection.execute(sa.text("SELECT :v"), {"v": SECRET_QUERY})
    statements = [str(s.attributes.get("db.statement", "")) for s in spans.get_finished_spans()]  # type: ignore[attr-defined]
    assert any("SELECT $1" in s for s in statements), statements
    assert not any(SECRET_QUERY in s for s in statements)
