async def test_a_replay_is_shaped_for_the_version_of_the_replaying_request(
    http: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    old, new = _old_and_new()
    monkeypatch.setattr(api_versions, "TRANSFORMERS", {new: _rename})
    payload = await _factories.payload_{{ target.table }}(http)
    headers = {"Idempotency-Key": "versioned-key-001"}
    first = await http.post(PATH, json=payload, headers={**headers, "API-Version": new})
