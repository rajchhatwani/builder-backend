def test_transformers_run_newest_first_for_every_newer_version(monkeypatch: pytest.MonkeyPatch) -> None:
    if len(versioning.VERSIONS) < 3:
        pytest.skip("needs three API versions")
    oldest, middle, newest = versioning.VERSIONS[0], versioning.VERSIONS[1], versioning.VERSIONS[-1]
    monkeypatch.setattr(
        api_versions,
        "TRANSFORMERS",
        {newest: lambda m, p, b: [*b, "undo-newest"], middle: lambda m, p, b: [*b, "undo-middle"]},
    )
    assert versioning.downgrade(oldest, "GET", "/x", []) == ["undo-newest", "undo-middle"]
    assert versioning.downgrade(middle, "GET", "/x", []) == ["undo-newest"]
    assert versioning.downgrade(newest, "GET", "/x", []) == []


