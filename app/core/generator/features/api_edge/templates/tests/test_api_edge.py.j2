class AfterCommit:
    """An after_commit hook that records what a second connection sees at that moment."""

    def __init__(self) -> None:
        self.rows_seen: list[int] = []

    async def __call__(self, _ctx: object) -> None:
        self.rows_seen.append(await _rows())  # its own connection: sees committed rows only


def _with_after_commit(patch: pytest.MonkeyPatch, hook: AfterCommit) -> None:
    patch.setattr(Repo, "hooks", {**Repo.hooks, "after_commit": (*Repo.hooks.get("after_commit", ()), hook)})


async def test_after_commit_runs_once_after_the_commit_and_never_on_a_replay(
    http: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    payload = await _factories.payload_{{ target.table }}(http)
    headers = {"Idempotency-Key": "after-commit-0001"}
    hook = AfterCommit()
    _with_after_commit(monkeypatch, hook)
    first = await http.post(PATH, json=payload, headers=headers)
    assert first.status_code == 201, first.text
    assert hook.rows_seen == [1]  # ran once, and the row was already visible to another connection
    replay = await http.post(PATH, json=payload, headers=headers)
    assert replay.headers["Idempotent-Replayed"] == "true"
    assert hook.rows_seen == [1]  # a replay does not run it again
    assert await _rows() == 1


async def test_after_commit_never_runs_when_a_keyed_request_fails(
    http: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    payload = await _factories.payload_{{ target.table }}(http)
    hook = AfterCommit()

    async def fail_late(_ctx: object) -> None:
        raise RuntimeError("forced failure after the row was written")

    real_commit = AsyncSession.commit

    async def refuse_keyed_commit(self: AsyncSession) -> None:
        if "commit" in vars(self):  # the keyed request's session (its commit is the deferred one)
            raise RuntimeError("commit refused")
        await real_commit(self)

    _with_after_commit(monkeypatch, hook)
    # a validation failure
    bad = await http.post(PATH, json={"unknown_field_only": 1}, headers={"Idempotency-Key": "ac-invalid-0001"})
    assert bad.status_code in (400, 422)
    # a failure inside the transaction, after the write
    with monkeypatch.context() as patch:
        patch.setattr(Repo, "hooks", {**Repo.hooks, "after_save": (*Repo.hooks.get("after_save", ()), fail_late)})
        failed = await http.post(PATH, json=payload, headers={"Idempotency-Key": "ac-failed-0001"})
    assert failed.status_code == 500
    # a response too large to store: the write is rolled back, so its effects must not happen
    assert definitions.IDEMPOTENCY is not None
    with monkeypatch.context() as patch:
        patch.setitem(definitions.IDEMPOTENCY, "max_response_bytes", 10)
        large = await http.post(PATH, json=payload, headers={"Idempotency-Key": "ac-large-00001"})
    assert large.status_code == 500
    # the database refuses the real commit
    with monkeypatch.context() as patch:
        patch.setattr(AsyncSession, "commit", refuse_keyed_commit)
        refused = await http.post(PATH, json=payload, headers={"Idempotency-Key": "ac-commit-0001"})
    assert refused.status_code == 503
    assert hook.rows_seen == []
    assert await _rows() == 0
    assert await _api_rows() == []


