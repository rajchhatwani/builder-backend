async def test_a_key_expires_and_expired_keys_are_purged(http: AsyncClient, monkeypatch: pytest.MonkeyPatch) -> None:
    clock = Clock()
    monkeypatch.setattr(idempotency, "now", clock)
    payload = await _factories.payload_{{ target.table }}(http)
