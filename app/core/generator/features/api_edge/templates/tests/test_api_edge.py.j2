def _request(peer: str | None, forwarded: str | None = None) -> Request:
    headers = [(b"x-forwarded-for", forwarded.encode())] if forwarded is not None else []
    scope = {"type": "http", "headers": headers, "client": (peer, 5000) if peer else None, "method": "GET", "path": "/"}
    return Request(scope)


def test_the_client_address_is_the_direct_peer_unless_a_proxy_is_trusted(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.delenv("API_EDGE_TRUSTED_PROXIES", raising=False)
    assert caller.client_ip(_request("10.0.0.1", "203.0.113.9")) == "10.0.0.1"  # forged header ignored
    assert caller.client_ip(_request(None)) == "unknown"
    monkeypatch.setenv("API_EDGE_TRUSTED_PROXIES", "10.0.0.0/8")
    assert caller.client_ip(_request("10.0.0.1", "203.0.113.9")) == "203.0.113.9"
    assert caller.client_ip(_request("10.0.0.1", "198.51.100.1, 203.0.113.9, 10.0.0.7")) == "203.0.113.9"
    assert caller.client_ip(_request("192.0.2.5", "203.0.113.9")) == "192.0.2.5"  # peer not a proxy
    assert caller.client_ip(_request("10.0.0.1", "not-an-ip")) == "10.0.0.1"
    monkeypatch.setenv("API_EDGE_TRUSTED_PROXIES", "10.0.0.0/8, nonsense")
    with pytest.raises(ValueError, match="API_EDGE_TRUSTED_PROXIES"):
        caller.client_ip(_request("10.0.0.1", "203.0.113.9"))


