def _rename(method: str, path: str, body: object) -> object:
    """A stand-in for a project transformer: the oldest shape called the id `legacy_id`."""
    if isinstance(body, dict) and "id" in body:
        body["legacy_id"] = body.pop("id")
    return body


async def test_an_old_version_keeps_its_old_shape_and_the_new_one_the_new(
    http: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    old, new = _old_and_new()
    monkeypatch.setattr(api_versions, "TRANSFORMERS", {new: _rename})
    payload = await _factories.payload_{{ target.table }}(http)
    as_new = await http.post(PATH, json=payload, headers={"API-Version": new})
    as_old = await http.post(PATH, json=payload, headers={"API-Version": old})
    assert as_new.status_code == as_old.status_code == 201
    assert "id" in as_new.json() and "legacy_id" not in as_new.json()
    assert "legacy_id" in as_old.json() and "id" not in as_old.json()
    assert as_old.headers["API-Version"] == old
    item_id = as_new.json()["id"]
    got_old = await http.get(f"{PATH}/{item_id}", headers={"API-Version": old})
    assert got_old.json()["legacy_id"] == item_id and "id" not in got_old.json()
    got_new = await http.get(f"{PATH}/{item_id}", headers={"API-Version": new})
    assert got_new.json()["id"] == item_id
    changelog = (await http.get("/api-versions")).json()
    assert next(v for v in changelog["versions"] if v["date"] == new)["transformer"] is True


async def test_a_transformer_that_fails_never_leaks_the_new_shape(
    http: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    old, new = _old_and_new()

    def broken(method: str, path: str, body: object) -> object:
        raise RuntimeError("bug in a transformer")

    monkeypatch.setattr(api_versions, "TRANSFORMERS", {new: broken})
    payload = await _factories.payload_{{ target.table }}(http)
    response = await http.post(PATH, json=payload, headers={"API-Version": old})
    assert response.status_code == 500
    assert response.json()["code"] == "api_version_transform_failed"
    assert "id" not in response.json()


