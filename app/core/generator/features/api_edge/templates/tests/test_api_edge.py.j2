async def test_a_caller_is_limited_and_gets_tokens_back_over_time(
    http: AsyncClient, clock: Clock, monkeypatch: pytest.MonkeyPatch
) -> None:
    _limits(monkeypatch, user={"capacity": 3, "refill_per_second": 1.0}, tenant=None, groups=[])
    seen = [await http.get(READ) for _ in range(3)]
    assert [r.status_code for r in seen] == [200, 200, 200]
    assert [r.headers["RateLimit-Remaining"] for r in seen] == ["2", "1", "0"]
    assert seen[0].headers["RateLimit-Limit"] == "3"
    refused = await http.get(READ)
    assert refused.status_code == 429
    assert refused.json()["code"] == "rate_limited"
    assert refused.headers["Retry-After"] == "1"
    assert refused.headers["RateLimit-Remaining"] == "0"
    clock.advance(seconds=2)
    assert [(await http.get(READ)).status_code for _ in range(3)] == [200, 200, 429]
    clock.advance(seconds=60)  # long idle: the bucket never holds more than its capacity
    assert [(await http.get(READ)).status_code for _ in range(4)] == [200, 200, 200, 429]


