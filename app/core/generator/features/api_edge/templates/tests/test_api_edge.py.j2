    assert (await http.post(PATH, json=payload, headers=headers)).headers["Idempotent-Replayed"] == "true"
    assert definitions.IDEMPOTENCY is not None
    clock.advance(hours=definitions.IDEMPOTENCY["ttl_hours"] + 1)
    again = await http.post(PATH, json=payload, headers=headers)
    assert again.status_code == 201
    assert "idempotent-replayed" not in again.headers  # the old key was gone: this ran for real
    assert await _rows() == 2
    clock.advance(hours=definitions.IDEMPOTENCY["ttl_hours"] + 1)
    async with session_factory() as session:
        assert await idempotency.purge(session) == 1
        await session.commit()
    assert await _api_rows() == []


