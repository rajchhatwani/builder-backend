"""Contract checks for the custom hooks (generated from the spec): the models, the fixed stub
signature and the registry wiring. Your own tests for a hook belong in tests/custom/."""

import ast
from pathlib import Path

import pytest
from pydantic import ValidationError

from app.hooks_gen import contracts, registry

ROOT = Path(__file__).resolve().parents[2]
{% for h in hooks %}


class Test_{{ h.name }}:
    INPUT = {{ h.input_sample }}
    OUTPUT = {{ h.output_sample }}

    def test_the_models_accept_a_valid_sample(self) -> None:
        assert contracts.{{ h.input_model }}.model_validate(self.INPUT)
        assert contracts.{{ h.output_model }}.model_validate(self.OUTPUT)

    def test_the_input_model_rejects_wrong_types(self) -> None:
{% for f in h.input_fields %}
        with pytest.raises(ValidationError):
            contracts.{{ h.input_model }}.model_validate({**self.INPUT, "{{ f }}": []})
{% endfor %}

    def test_the_models_reject_unknown_fields(self) -> None:
        with pytest.raises(ValidationError):
            contracts.{{ h.input_model }}.model_validate({**self.INPUT, "unknown_field": 1})
        with pytest.raises(ValidationError):
            contracts.{{ h.output_model }}.model_validate({**self.OUTPUT, "unknown_field": 1})
{% if h.required_input %}

    def test_the_input_model_needs_its_required_fields(self) -> None:
{% for f in h.required_input %}
        with pytest.raises(ValidationError):
            contracts.{{ h.input_model }}.model_validate(
                {k: v for k, v in self.INPUT.items() if k != "{{ f }}"}
            )
{% endfor %}
{% endif %}

    def test_the_stub_signature_is_unchanged(self) -> None:
        text = (ROOT / "{{ h.file }}").read_text(encoding="utf-8")
        lines = text.splitlines()
        assert lines.count({{ h.signature | pyrepr }}) == 1
        assert lines.count({{ h.open_marker | pyrepr }}) == 1
        assert lines.count("    # </agent:body>") == 1
        function = next(
            n for n in ast.parse(text).body if isinstance(n, ast.FunctionDef) and n.name == "{{ h.name }}"
        )
        assert [a.arg for a in function.args.args] == ["data"]
        assert ast.unparse(function.args.args[0].annotation) == "{{ h.input_model }}"
        assert ast.unparse(function.returns) == "{{ h.output_model }}"

    def test_the_function_is_wired_into_the_registry(self) -> None:
        hook = registry.HOOKS["{{ h.name }}"]
        assert hook["fn"].__name__ == "{{ h.name }}"
        assert hook["input"] is contracts.{{ h.input_model }}
        assert hook["output"] is contracts.{{ h.output_model }}
{% endfor %}
