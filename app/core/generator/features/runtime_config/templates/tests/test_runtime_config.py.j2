{% for name, d in sequences.items() %}


async def test_sequence_{{ name }}_hands_out_consecutive_numbers_and_ignores_rollbacks() -> None:
{% if d.per_tenant %}
    tenant = uuid.uuid4()
    kwargs = {"tenant_id": tenant}
{% else %}
    kwargs = {}
{% endif %}
    async with session_factory() as session:
        first = await _sequences.next_number(session, {{ name | pyrepr }}, **kwargs)
        await session.commit()
    async with session_factory() as session:
        await _sequences.next_number(session, {{ name | pyrepr }}, **kwargs)
        await session.rollback()  # this number was never used: it must come back
    async with session_factory() as session:
        second = await _sequences.next_number(session, {{ name | pyrepr }}, **kwargs)
        await session.commit()
    assert first.endswith(str({{ d.start }}).zfill({{ d.padding }}))
    assert second.endswith(str({{ d.start + 1 }}).zfill({{ d.padding }}))
    assert first.startswith({{ d.prefix | pyrepr }}) and second.startswith({{ d.prefix | pyrepr }})
{% endfor %}
