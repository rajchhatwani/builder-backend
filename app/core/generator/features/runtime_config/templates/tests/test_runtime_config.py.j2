def test_every_setting_default_passes_its_own_validation() -> None:
    for key, definition in _settings.SETTINGS.items():
        assert _settings.check_value(key, definition["default"]) is not None
{% for key, d in settings.items() %}
{% if d.type == "bool" %}


def test_setting_{{ key }}_refuses_a_non_boolean() -> None:
    with pytest.raises(AppError) as excinfo:
        _settings.check_value({{ key | pyrepr }}, "yes")
    assert excinfo.value.status_code == 422
{% elif d.type == "int" %}


def test_setting_{{ key }}_refuses_a_non_integer() -> None:
    for bad in ("7", 1.5, True):
        with pytest.raises(AppError) as excinfo:
            _settings.check_value({{ key | pyrepr }}, bad)
        assert excinfo.value.status_code == 422
{% elif d.type == "decimal" %}


def test_setting_{{ key }}_refuses_a_float_or_text() -> None:
    for bad in (1.5, "abc", True):
        with pytest.raises(AppError) as excinfo:
            _settings.check_value({{ key | pyrepr }}, bad)
        assert excinfo.value.status_code == 422
