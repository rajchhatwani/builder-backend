"""Search routes (generated): GET /<entity>/search?q=&limit= for entities with searchable fields.

Same caller access as the entity's list endpoint (roles, tenant, owner / row scope, policy). Fields the
caller may not read are not searched and not returned. Engine: SEARCH_BACKEND (see app/search/config.py)."""

import typing as _t

import fastapi as _fa

from app import db as _db
{% if with_access %}
from app.auth import access as _access
{% endif %}
{% if entities | selectattr("guarded") | list %}
from app.auth import field_access as _fx
{% endif %}
{% for e in entities %}
from app.crud.{{ e.table }} import {{ e.name }}Repository
{% endfor %}
{% for e in entities if "list" in e.access_ops %}
from app.routers.{{ e.table }} import _ACCESS as _ACCESS_{{ e.table }}
{% endfor %}
{% for e in entities %}
from app.schemas.{{ e.table }} import {{ e.name }}Read
{% endfor %}
from app.search import service as _service

router = _fa.APIRouter(tags=["search"])
_Q = _t.Annotated[str, _fa.Query(min_length=1, max_length={{ max_q }}, description="Words to look for")]
_LIMIT = _t.Annotated[int, _fa.Query(ge=1, le={{ max_limit }})]
{% for e in entities %}


@router.get(
    "/{{ e.path }}/search",
    response_model=_service.SearchPage[{{ e.name }}Read]{{ ", response_model_exclude_unset=True" if e.guarded else "" }},
)
async def search_{{ e.table }}(
    session: _db.SessionDep,
    q: _Q,
{% if "list" in e.access_ops %}
    access: _t.Annotated[_access.Access, _fa.Depends(_ACCESS_{{ e.table }}["list"])],
{% endif %}
    limit: _LIMIT = 20,
) -> _service.SearchPage[{{ e.name }}Read]:
    """Search {{ e.searchable | join(", ") }} of {{ e.name }}."""
{% if e.guarded %}
    hidden = _fx.hidden_read("{{ e.name }}", {{ "access.user" if "list" in e.access_ops else "None" }})
{% else %}
    hidden = frozenset[str]()
{% endif %}
    repo = {{ e.name }}Repository(session{{ ", **access.repo_kwargs" if "list" in e.access_ops else "" }})
    rows, total = await _service.find(repo, q, limit, hidden)
    return _service.SearchPage[{{ e.name }}Read](
        items=[{{ ("_fx.shape(\"" ~ e.name ~ "\", " ~ ("access.user" if "list" in e.access_ops else "None") ~ ", " ~ e.name ~ "Read.model_validate(row))") if e.guarded else (e.name ~ "Read.model_validate(row)") }} for row in rows],
        total=total,
        limit=limit,
    )
{% endfor %}
