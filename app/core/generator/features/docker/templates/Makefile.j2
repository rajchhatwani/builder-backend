.PHONY: up down test lint{% if pay %} worker reconcile{% endif %}

up:
	docker compose up --build

down:
	docker compose down

# Runs the smoke tests against a throwaway "<db>_test" database, never the dev database.
test:
{% if keycloak %}
	# Only the database is needed: the tests sign their own tokens, so Keycloak is not started.
	# The placeholders satisfy the required settings of the services this target does not run.
	docker compose up -d --wait db
	KEYCLOAK_DB_PASSWORD=unused KC_BOOTSTRAP_ADMIN_USERNAME=unused KC_BOOTSTRAP_ADMIN_PASSWORD=unused{% for env_name in idp_secret_names %} {{ env_name }}=unused{% endfor %} 		docker compose run --rm --no-deps -e DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app_test api sh -c "python -m tests._prepare_db && alembic upgrade head && pytest"
{% else %}
	docker compose run --rm -e DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app_test api sh -c "python -m tests._prepare_db && alembic upgrade head && pytest"
{% endif %}

lint:
	ruff check .
{% if pay %}

# Run one more payments worker here (more can run on other machines: deploy/compose.worker.yml).
worker:
	docker compose run --rm payments-worker

# Compare our payments with the provider's and repair differences. Safe to run at any time.
reconcile:
	docker compose run --rm --no-deps payments-worker python -m app.payments.reconcile
{% endif %}
