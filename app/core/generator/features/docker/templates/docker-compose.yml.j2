{% if pay %}
# Settings every payments process shares (the API and the workers).
x-payments-env: &payments-env
  APP_ENV: ${APP_ENV:-production}
{% for name in prov.key_envs + (prov.webhook_secret_env,) %}
  {{ name }}: ${ {{- name }}:?set {{ name }} in .env (see .env.example)}
{% endfor %}
  PAYMENTS_WEBHOOK_MODE: ${PAYMENTS_WEBHOOK_MODE:-{{ sizing.webhook_mode }}}
  {{ prov.env_prefix }}_API_BASE: ${ {{- prov.env_prefix }}_API_BASE:-{{ prov.api_base }}}
  PAYMENTS_JOB_LEASE_SECONDS: ${PAYMENTS_JOB_LEASE_SECONDS:-120}
{% if pay.security.webhook_ip_allowlist_enabled %}
  PAYMENTS_WEBHOOK_IP_ALLOWLIST: ${PAYMENTS_WEBHOOK_IP_ALLOWLIST:?set PAYMENTS_WEBHOOK_IP_ALLOWLIST in .env (see .env.example)}
{% endif %}
{% if pay.scale.pgbouncer %}
  DB_PGBOUNCER: "true"
{% endif %}

{% endif %}
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 3s
      timeout: 3s
      retries: 20

{% if pay and pay.scale.pgbouncer %}
  # Pools connections to the database: many application connections, few database ones.
  pgbouncer:
    image: {{ pgbouncer_image }}
    environment:
      DB_HOST: db
      DB_USER: app
      DB_PASSWORD: app
      DB_NAME: app
      LISTEN_PORT: "6432"
      POOL_MODE: transaction
      AUTH_TYPE: scram-sha-256
      DEFAULT_POOL_SIZE: "{{ sizing.pgbouncer_pool_size }}"
      MAX_CLIENT_CONN: "1000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 6432 -U app"]
      interval: 3s
      timeout: 3s
      retries: 20
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    restart: unless-stopped

{% endif %}
  api:
    build: .
    environment:
{% if pay %}
      <<: *payments-env
      UVICORN_WORKERS: ${UVICORN_WORKERS:-{{ single_host_workers }}}
      DB_POOL_SIZE: ${DB_POOL_SIZE:-{{ sizing.pool_size }}}
      DB_MAX_OVERFLOW: ${DB_MAX_OVERFLOW:-{{ sizing.max_overflow }}}
{% endif %}
{% if pay and pay.scale.pgbouncer %}
      DATABASE_URL: postgresql+asyncpg://app:app@pgbouncer:6432/app
{% else %}
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/app
{% endif %}
{% if otel %}
      # OpenTelemetry (see docs/OBSERVABILITY.md). Empty endpoint: nothing leaves the container.
      APP_OTEL_ENABLED: ${APP_OTEL_ENABLED:-true}
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
      OTEL_EXPORTER_OTLP_HEADERS: ${OTEL_EXPORTER_OTLP_HEADERS:-}
      OTEL_TRACES_SAMPLER_ARG: ${OTEL_TRACES_SAMPLER_ARG:-{{ otel_ratio }}}
{% endif %}
{% if storage %}
      # File storage: the bucket, the malware scanner (see deploy/storage/STORAGE.md).
      APP_ENV: ${APP_ENV:-production}
      STORAGE_ENDPOINT_URL: ${STORAGE_ENDPOINT_URL:-{{ 'http://objectstore:8333' if minio else '' }}}
      STORAGE_PUBLIC_ENDPOINT_URL: ${STORAGE_PUBLIC_ENDPOINT_URL:-{{ 'http://localhost:8333' if minio else '' }}}
      STORAGE_REGION: ${STORAGE_REGION:-}
{% if minio %}
      STORAGE_ACCESS_KEY_ID: ${STORAGE_ACCESS_KEY_ID:?set STORAGE_ACCESS_KEY_ID in .env (see .env.example)}
      STORAGE_SECRET_ACCESS_KEY: ${STORAGE_SECRET_ACCESS_KEY:?set STORAGE_SECRET_ACCESS_KEY in .env (see .env.example)}
      STORAGE_CREATE_BUCKET: ${STORAGE_CREATE_BUCKET:-true}
{% else %}
      STORAGE_ACCESS_KEY_ID: ${STORAGE_ACCESS_KEY_ID:-}
      STORAGE_SECRET_ACCESS_KEY: ${STORAGE_SECRET_ACCESS_KEY:-}
{% endif %}
      STORAGE_SSE: ${STORAGE_SSE:-auto}
      STORAGE_TRUSTED_PROXIES: ${STORAGE_TRUSTED_PROXIES:-0}
      CLAMD_HOST: ${CLAMD_HOST:-clamav}
      CLAMD_PORT: ${CLAMD_PORT:-3310}
{% endif %}
{% if provider_vault %}
      # The master key of the per-tenant credential vault (app/providers). Required: a deployment without
      # one cannot start. Rotation: raise PROVIDER_VAULT_KEY_VERSION and list old keys in ..._PREVIOUS.
{% if not storage and not pay %}
      APP_ENV: ${APP_ENV:-production}
{% endif %}
      PROVIDER_VAULT_KEY: ${PROVIDER_VAULT_KEY:?set PROVIDER_VAULT_KEY in .env (see .env.example)}
      PROVIDER_VAULT_KEY_VERSION: ${PROVIDER_VAULT_KEY_VERSION:-1}
      PROVIDER_VAULT_KEY_PREVIOUS: ${PROVIDER_VAULT_KEY_PREVIOUS:-}
{% endif %}
{% if auth and not keycloak %}
      # Copy .env.example to .env and fill these in; compose reads .env automatically.
{% if rs256 %}
      AUTH_JWT_PRIVATE_KEY: ${AUTH_JWT_PRIVATE_KEY:?set AUTH_JWT_PRIVATE_KEY in .env (see .env.example)}
{% else %}
      AUTH_JWT_SECRET: ${AUTH_JWT_SECRET:?set AUTH_JWT_SECRET in .env (see .env.example)}
{% endif %}
{% if redis_store %}
      REDIS_URL: redis://redis:6379/0
{% endif %}
{% if auth.smtp %}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD: ${SMTP_PASSWORD:-}
{% endif %}
{% if sms_provider == "twilio" %}
      TWILIO_ACCOUNT_SID: ${TWILIO_ACCOUNT_SID:-}
      TWILIO_AUTH_TOKEN: ${TWILIO_AUTH_TOKEN:-}
{% elif sms_provider == "vonage" %}
      VONAGE_API_KEY: ${VONAGE_API_KEY:-}
      VONAGE_API_SECRET: ${VONAGE_API_SECRET:-}
{% elif sms_provider == "aws_sns" %}
      AWS_REGION: ${AWS_REGION:-}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:-}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY:-}
{% endif %}
{% elif keycloak %}
      # Where people reach Keycloak, and where this service fetches its signing keys from.
{% if kc_own %}
      KEYCLOAK_PUBLIC_URL: ${KEYCLOAK_PUBLIC_URL:-http://localhost:8081}
      KEYCLOAK_INTERNAL_URL: http://keycloak:8080
{% else %}
      KEYCLOAK_PUBLIC_URL: ${KEYCLOAK_PUBLIC_URL:?set KEYCLOAK_PUBLIC_URL in .env (see .env.example)}
      KEYCLOAK_INTERNAL_URL: ${KEYCLOAK_INTERNAL_URL:-}
{% endif %}
      APP_ENV: ${APP_ENV:-production}
      AUTH_ALLOW_PROVIDER_SWITCH: ${AUTH_ALLOW_PROVIDER_SWITCH:-false}
{% endif %}
    depends_on:
      db:
        condition: service_healthy
{% if pay and pay.scale.pgbouncer %}
      pgbouncer:
        condition: service_healthy
{% endif %}
{% if redis_store %}
      redis:
        condition: service_healthy
{% endif %}
{% if kc_own %}
      keycloak:
        condition: service_healthy
{% endif %}
{% if storage and minio %}
      objectstore:
        condition: service_healthy
{% endif %}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
      interval: 3s
      timeout: 3s
      retries: 30
    ports:
      - "${API_PORT:-8000}:8000"
{% if pay %}

  # Runs the queue and the periodic jobs. Scale with `docker compose up --scale payments-worker=N`,
  # or run more of them on other machines with deploy/compose.worker.yml.
  payments-worker:
    build: .
    command: ["python", "-m", "app.payments.worker"]
    environment:
      <<: *payments-env
{% if pay.scale.pgbouncer %}
      DATABASE_URL: postgresql+asyncpg://app:app@pgbouncer:6432/app
{% else %}
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/app
{% endif %}
      PAYMENTS_WORKER_CONCURRENCY: ${PAYMENTS_WORKER_CONCURRENCY:-{{ sizing.worker_concurrency }}}
      PAYMENTS_POLL_INTERVAL_SECONDS: ${PAYMENTS_POLL_INTERVAL_SECONDS:-{{ sizing.poll_interval_seconds }}}
      DB_POOL_SIZE: ${DB_POOL_SIZE_WORKER:-{{ sizing.worker_pool_size }}}
      DB_MAX_OVERFLOW: "0"
{% if keycloak %}
      KEYCLOAK_PUBLIC_URL: ${KEYCLOAK_PUBLIC_URL:-http://localhost:8081}
{% if kc_own %}
      KEYCLOAK_INTERNAL_URL: http://keycloak:8080
{% else %}
      KEYCLOAK_INTERNAL_URL: ${KEYCLOAK_INTERNAL_URL:-}
{% endif %}
{% endif %}
    depends_on:
      db:
        condition: service_healthy
{% if pay.scale.pgbouncer %}
      pgbouncer:
        condition: service_healthy
{% endif %}
    deploy:
      replicas: ${WORKER_REPLICAS:-{{ sizing.worker_replicas }}}
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    stop_grace_period: 40s
    restart: unless-stopped
{% endif %}
{% for g in jobs_groups %}

  # Job worker group "{{ g.name }}" ({{ g.concurrency }} job(s) at a time per process). Scale with
  # `docker compose up --scale worker-{{ g.service }}=N`. Your handlers (app/hooks/jobs.py) may need more settings here.
  worker-{{ g.service }}:
    build: .
    command: ["python", "-m", "app.jobs.worker", "--group", "{{ g.name }}"]
    environment:
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/app
      APP_ENV: ${APP_ENV:-production}
      JOBS_CONCURRENCY: ${JOBS_CONCURRENCY_{{ g.service | upper | replace("-", "_") }}:-{{ g.concurrency }}}
      DB_POOL_SIZE: ${DB_POOL_SIZE_{{ g.service | upper | replace("-", "_") }}:-{{ g.concurrency + 2 }}}
      DB_MAX_OVERFLOW: "0"
    depends_on:
      db:
        condition: service_healthy
      api:
        condition: service_healthy
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    stop_grace_period: 40s
    restart: unless-stopped
{% endfor %}
{% if workflows_worker %}

  # Durable workflow worker. Scale with `docker compose up --scale workflow-worker=N`: a run is driven by one
  # worker at a time and survives this process being killed. Your step functions (app/hooks/workflows.py)
  # may need more settings here.
  workflow-worker:
    build: .
    command: ["python", "-m", "app.workflows.worker"]
    environment:
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/app
      APP_ENV: ${APP_ENV:-production}
      WORKFLOWS_CONCURRENCY: ${WORKFLOWS_CONCURRENCY:-{{ workflows_concurrency }}}
      DB_POOL_SIZE: ${DB_POOL_SIZE_WORKFLOWS:-{{ workflows_concurrency + 2 }}}
      DB_MAX_OVERFLOW: "0"
    depends_on:
      db:
        condition: service_healthy
      api:
        condition: service_healthy
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    stop_grace_period: 40s
    restart: unless-stopped
{% endif %}
{% if storage %}

  # Scans every upload before it is stored. It has no authentication, so no port is published:
  # only containers on this compose network can reach it. Needs about 1.5 GB of memory; the first
  # start downloads the virus signatures (a few minutes), and the API refuses uploads until it is up.
  clamav:
    image: {{ clamav_image }}
    environment:
      # Sized from this project's limit of {{ s.max_file_mb }} MB per file. Files clamd cannot scan completely
      # (too large, too deeply nested) are reported as detections, never let through.
      CLAMD_CONF_StreamMaxLength: "{{ clamd_limit_mb }}M"
      CLAMD_CONF_MaxFileSize: "{{ clamd_limit_mb }}M"
      CLAMD_CONF_MaxScanSize: "{{ clamd_limit_mb * 4 }}M"
      CLAMD_CONF_MaxRecursion: "10"
      CLAMD_CONF_MaxFiles: "10000"
      CLAMD_CONF_AlertExceedsMax: "yes"
    volumes:
      - clamav_db:/var/lib/clamav
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
{% endif %}
{% if storage and minio %}

  # A local S3-compatible server for development ({{ dev_s3_image }}; MinIO no longer publishes images, see
  # deploy/storage/STORAGE.md). Single node, plain http, no replication: not a production store.
  objectstore:
    image: {{ dev_s3_image }}
    command: ["server", "-s3", "-dir=/data", "-ip.bind=0.0.0.0"]
    environment:
      AWS_ACCESS_KEY_ID: ${STORAGE_ACCESS_KEY_ID:?set STORAGE_ACCESS_KEY_ID in .env (see .env.example)}
      AWS_SECRET_ACCESS_KEY: ${STORAGE_SECRET_ACCESS_KEY:?set STORAGE_SECRET_ACCESS_KEY in .env (see .env.example)}
    volumes:
      - objectstore_data:/data
{% if s.download_mode == "presigned" %}
    ports:
      # Presigned download links point browsers here; loopback only.
      - "127.0.0.1:${OBJECTSTORE_PORT:-8333}:8333"
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 8333"]
      interval: 3s
      timeout: 3s
      retries: 40
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
{% endif %}
{% if redis_store %}

  redis:
    image: redis:7-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 3s
      timeout: 3s
      retries: 20
{% endif %}
{% if kc_own %}

  keycloak_db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?set KEYCLOAK_DB_PASSWORD in .env (see .env.example)}
      POSTGRES_DB: keycloak
    volumes:
      - keycloak_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak -d keycloak"]
      interval: 3s
      timeout: 3s
      retries: 20
    restart: unless-stopped

  keycloak:
    image: {{ keycloak_image }}:{{ keycloak_tag }}
    # Production mode. It listens on plain http, so put a TLS-terminating proxy in front of it
    # for anything but local work and set KEYCLOAK_PUBLIC_URL to the https address (README).
    command: ["start", "--import-realm"]
    environment:
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://keycloak_db:5432/keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?set KEYCLOAK_DB_PASSWORD in .env (see .env.example)}
      KC_HOSTNAME: ${KEYCLOAK_PUBLIC_URL:-http://localhost:8081}
      KC_HTTP_ENABLED: "true"
      KC_HEALTH_ENABLED: "true"
      # Behind a trusted TLS proxy that sets the X-Forwarded-* headers, add this line:
      #   KC_PROXY_HEADERS: xforwarded
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KC_BOOTSTRAP_ADMIN_USERNAME:?set KC_BOOTSTRAP_ADMIN_USERNAME in .env (see .env.example)}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KC_BOOTSTRAP_ADMIN_PASSWORD:?set KC_BOOTSTRAP_ADMIN_PASSWORD in .env (see .env.example)}
      # Filled into keycloak/realm.json (${NAME} placeholders) when the realm is imported.
      API_PUBLIC_URL: ${API_PUBLIC_URL:-http://localhost:8000}
{% if auth.smtp %}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD: ${SMTP_PASSWORD:-}
{% endif %}
{% for alias, env_name in idp_secrets %}
      {{ env_name }}: ${ {{- env_name }}:?set {{ env_name }} in .env (see .env.example)}
{% endfor %}
    volumes:
      - ./keycloak/realm.json:/opt/keycloak/data/import/realm.json:ro
    ports:
      - "${KEYCLOAK_PORT:-8081}:8080"
    # Keycloak needs no extra privileges, so it gets none.
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    depends_on:
      keycloak_db:
        condition: service_healthy
    healthcheck:
      # The management port (9000) is not published; this asks it from inside the container
      # and passes only on HTTP 200 (a 503 means Keycloak is still starting).
      test:
        - CMD
        - bash
        - -c
        - |
          exec 3<>/dev/tcp/127.0.0.1/9000
          printf 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
          read -r status <&3
          [[ "$$status" == *" 200 "* ]]
      interval: 5s
      timeout: 5s
      retries: 40
      start_period: 20s
    restart: unless-stopped
{% endif %}

volumes:
  db_data:
{% if storage %}
  clamav_db:
{% endif %}
{% if storage and minio %}
  objectstore_data:
{% endif %}
{% if kc_own %}
  keycloak_db_data:
{% endif %}
