# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# JSON list
CORS_ORIGINS=["*"]
{% if auth %}

# --- Authentication -------------------------------------------------------------------
{% if rs256 %}
# RSA private key that signs access tokens (RS256). Other services can verify tokens with the
# public key served at /auth/jwks.json. Generate one and paste the line it prints over the one below:
#   docker run --rm -v "$PWD":/srv -w /srv python:3.12-slim sh -c "pip install -q cryptography && python -m app.auth.keys"
AUTH_JWT_PRIVATE_KEY=
{% else %}
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
{% endif %}
{% if redis_store %}
# Refresh tokens are kept in Redis (docker compose provides one).
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if auth.smtp %}
# Credentials for {{ auth.smtp.host }}:{{ auth.smtp.port }}
SMTP_USERNAME=
SMTP_PASSWORD=
{% endif %}
{% if sms_provider == "twilio" %}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
{% elif sms_provider == "vonage" %}
VONAGE_API_KEY=
VONAGE_API_SECRET=
{% elif sms_provider == "aws_sns" %}
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a profile or an instance role).
AWS_REGION=
{% endif %}
{% endif %}
