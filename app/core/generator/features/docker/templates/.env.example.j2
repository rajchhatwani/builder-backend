# Copy to .env for running outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
LOG_LEVEL=INFO
# JSON list
CORS_ORIGINS=["*"]
{% if otel %}

# --- Observability (OpenTelemetry), see docs/OBSERVABILITY.md --------------------------
APP_OTEL_ENABLED=true
# Collector address. Empty: nothing leaves the process. With the local stack (docker compose -f
# docker-compose.yml -f deploy/observability/compose.yml up) this is set for you.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Credentials for a hosted backend (a secret).
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG={{ otel_ratio }}
{% endif %}
{% if auth and not keycloak %}

# --- Authentication -------------------------------------------------------------------
{% if rs256 %}
# RSA private key that signs access tokens (RS256). Other services can verify tokens with the
# public key served at /auth/jwks.json. Generate one and paste the line it prints over the one below:
#   docker run --rm -v "$PWD":/srv -w /srv python:3.12-slim sh -c "pip install -q cryptography && python -m app.auth.keys"
AUTH_JWT_PRIVATE_KEY=
{% else %}
# Signs access tokens (at least 32 characters). Generate one and paste the line it prints over the one below:
#   python3 -m app.auth.keys
AUTH_JWT_SECRET=
{% endif %}
{% if redis_store %}
# Refresh tokens are kept in Redis (docker compose provides one).
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if auth.smtp %}
# Credentials for {{ auth.smtp.host }}:{{ auth.smtp.port }}
SMTP_USERNAME=
SMTP_PASSWORD=
{% endif %}
{% if sms_provider == "twilio" %}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
{% elif sms_provider == "vonage" %}
VONAGE_API_KEY=
VONAGE_API_SECRET=
{% elif sms_provider == "aws_sns" %}
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a profile or an instance role).
AWS_REGION=
{% endif %}
{% elif keycloak %}

# --- Authentication (Keycloak) --------------------------------------------------------
# Where people reach Keycloak: the address in their browser. Tokens are only accepted from
# exactly this issuer, and it must be https when APP_ENV=production.
{% if kc_own %}
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Port Keycloak is published on (change KEYCLOAK_PUBLIC_URL to match).
KEYCLOAK_PORT=8081
{% else %}
KEYCLOAK_PUBLIC_URL=
# Optional: how this service reaches Keycloak if it cannot use the public address.
KEYCLOAK_INTERNAL_URL=
{% endif %}
# Set to production in production: it refuses a plain http Keycloak address.
APP_ENV=development
# Where this API is reachable. Swagger UI (/docs) signs in through Keycloak and returns here.
API_PUBLIC_URL=http://localhost:8000
{% if kc_own %}

# Keycloak's own database. Choose a long random password.
KEYCLOAK_DB_PASSWORD=
# The first Keycloak admin (used once to create your real admin account, then remove them).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
{% if auth.smtp %}
# Credentials for {{ auth.smtp.host }}:{{ auth.smtp.port }} (Keycloak sends the emails)
SMTP_USERNAME=
SMTP_PASSWORD=
{% endif %}
{% for alias, env_name in idp_secrets %}
# Client secret of the {{ alias }} login (from the provider's console)
{{ env_name }}=
{% endfor %}
{% else %}

# Admin account of the shared Keycloak, only for scripts/keycloak_register.py (not read by the API).
# KEYCLOAK_ADMIN_USERNAME=
# KEYCLOAK_ADMIN_PASSWORD=
{% endif %}
# Start once with true to move this database to a different identity provider on purpose.
AUTH_ALLOW_PROVIDER_SWITCH=false
{% endif %}
{% if storage %}

# --- File storage ---------------------------------------------------------------------
# Secrets: environment only, never committed. (NAME_FILE=/run/secrets/x reads a secret from a file.)
# Full guide: deploy/storage/STORAGE.md. Bucket: {{ s.bucket }}
{% if minio %}
# Your S3-compatible server (compose starts a local development one at http://objectstore:8333).
# Must be https:// when APP_ENV=production.
STORAGE_ENDPOINT_URL=http://localhost:8333
# Credentials of that server. The local development server takes these as its own admin login;
# use a credential limited to the bucket for a real one. Choose long random values.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Development only: create the bucket if it is missing.
STORAGE_CREATE_BUCKET=true
# Address browsers use for presigned download links, if it differs from the one above.
# STORAGE_PUBLIC_ENDPOINT_URL=
{% else %}
# AWS: leave the credentials empty and give the service an IAM role. Otherwise fill both.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION={{ s.region }}
# Only for an S3-compatible server that is not AWS.
# STORAGE_ENDPOINT_URL=
{% endif %}
# auto: SSE-S3 on AWS, none on a custom endpoint. Or AES256, aws:kms (with STORAGE_KMS_KEY_ID), none.
STORAGE_SSE=auto
# Reverse proxies whose X-Forwarded-For is believed when the audit trail records an address.
STORAGE_TRUSTED_PROXIES=0
# The malware scanner (the compose service of that name).
CLAMD_HOST=localhost
CLAMD_PORT=3310
{% if not pay and not keycloak %}
APP_ENV=development
{% endif %}
{% endif %}
{% if pay %}

# --- Payments ({{ pay.provider }}) ---------------------------------------------------------
# Secrets: environment only, never committed. (NAME_FILE=/run/secrets/x reads a secret from a file.)
# Test mode keys ({{ prov.key_example }}) outside production. Live keys only work with APP_ENV=production.
{% for name in prov.key_envs %}
{{ name }}=
{% endfor %}
# The signing secret(s) of the webhook endpoint (comma-separate two while rotating).
{{ prov.webhook_secret_env }}=
APP_ENV=development
# inline = process a webhook inside its request, queued = hand it to the workers.
PAYMENTS_WEBHOOK_MODE={{ sizing.webhook_mode }}
{% if pay.security.webhook_ip_allowlist_enabled %}
# Required: the addresses the provider calls from, as comma-separated CIDRs.
PAYMENTS_WEBHOOK_IP_ALLOWLIST=
{% endif %}
# Sizing for the expected load ({{ sizing.payments_per_minute }} payments/minute at peak). Estimates:
# see deploy/DEPLOYMENT.md before relying on them.
UVICORN_WORKERS={{ single_host_workers }}
DB_POOL_SIZE={{ sizing.pool_size }}
DB_MAX_OVERFLOW={{ sizing.max_overflow }}
WORKER_REPLICAS={{ sizing.worker_replicas }}
PAYMENTS_WORKER_CONCURRENCY={{ sizing.worker_concurrency }}
{% endif %}
