# Run ONCE per AWS account by an administrator, from a laptop or a trusted shell, with your own
# credentials. It creates what the pipeline needs before it can run: the Terraform state bucket, the
# image registry, and the trust that lets this repository's GitHub Actions workflows assume a role
# without any stored key. Its own state stays local (terraform.tfstate here): keep that file safe.
terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region
}
