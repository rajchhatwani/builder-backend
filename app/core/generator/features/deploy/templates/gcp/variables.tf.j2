variable "project" {
  description = "Name prefix of every resource."
  type        = string
  default     = "{{ slug }}"
}

variable "project_id" {
  description = "Google Cloud project id (passed by the pipeline from the GCP_PROJECT_ID variable)."
  type        = string
}

variable "app_env" {
  description = "APP_ENV of the service: production switches on the strict checks (https URLs, live keys)."
  type        = string
  default     = "production"
}

variable "environment" {
  description = "dev, staging, prod ... (set by environments/<name>.tfvars)."
  type        = string
}

variable "region" {
  type = string
}

variable "image" {
  description = "Full image reference with a tag or digest, passed by the pipeline."
  type        = string

  validation {
    condition     = can(regex(":", var.image)) || can(regex("@sha256:", var.image))
    error_message = "image must include a tag or a digest."
  }
}

variable "cpu" {
  description = "Container CPU in millicores (1000, 2000 or 4000)."
  type        = number
}

variable "memory" {
  description = "Container memory in MB."
  type        = number
}

variable "min_instances" {
  type = number
}

variable "max_instances" {
  type = number
}

variable "db_class" {
  type = string
}

variable "db_storage_gb" {
  type = number
}

variable "db_high_availability" {
  description = "A standby database in a second zone (regional availability)."
  type        = bool
}

variable "deletion_protection" {
  description = "Blocks deleting the database and the service."
  type        = bool
}

variable "subnet_cidr" {
  type    = string
  default = "10.40.0.0/24"
}

variable "app_env_vars" {
  description = "Plain (non-secret) environment variables of the service, for example CORS_ORIGINS."
  type        = map(string)
  default     = {}
}
