{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectsUnderThePrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::{{ s.bucket }}/{{ s.key_prefix }}/*"
    },
    {
      "Sid": "ListAndCheckTheBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::{{ s.bucket }}"
    }
  ]
}
