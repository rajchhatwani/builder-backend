{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::{{ s.bucket }}",
        "arn:aws:s3:::{{ s.bucket }}/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyOldTlsVersions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::{{ s.bucket }}",
        "arn:aws:s3:::{{ s.bucket }}/*"
      ],
      "Condition": { "NumericLessThan": { "s3:TlsVersion": 1.2 } }
    }
  ]
}
