# Edge proxy for the beta/production stack: automatic HTTPS (Let's Encrypt), the dashboard's static
# files, and one origin for dashboard + API (the refresh cookie is SameSite=Strict).
{
	email {$ACME_EMAIL}
	# host network: the default admin endpoint (localhost:2019, unauthenticated) would be reachable by every host process
	admin off
}

{$BB_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@static {
		path / /assets/* /favicon.svg /index.html
	}
	handle @static {
		root * /srv
		file_server
	}
	# Browser navigation to dashboard routes shares paths such as /projects with the API.
	@dashboard path_regexp ^/(account|sign-in|login|signin|signup|verify-email|sso/complete|sso-complete|invitations|org/[^/]+|v2-kit|projects(/[^/]+(/[^/]+)?)?)/?$
	@navigation {
		method GET HEAD
		header Accept *text/html*
	}
	route @dashboard {
		header +Vary Accept
		handle @navigation {
			root * /srv
			rewrite * /index.html
			file_server
		}
	}
	reverse_proxy {$API_UPSTREAM:api:8000}
}

# Keycloak (identity provider you host). Remove this block if you do not run it.
{$KC_DOMAIN} {
	reverse_proxy {$KC_UPSTREAM:keycloak:8080}
}

# Extra sites (the preview origin is added here by docker-compose.sandbox.yml).
import /etc/caddy/sites/*.caddy
