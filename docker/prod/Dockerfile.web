# Dashboard (built once, API origin baked in) served by Caddy with automatic HTTPS.
# Build from the repo root: docker build -f docker/prod/Dockerfile.web --build-arg VITE_API_BASE_URL=https://app.example.com .
FROM node:24-alpine AS build
ARG VITE_API_BASE_URL
ARG VITE_PREVIEW_API_ORIGIN=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_PREVIEW_API_ORIGIN=$VITE_PREVIEW_API_ORIGIN
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npx vite build --outDir /dist --emptyOutDir

FROM caddy:2-alpine
COPY docker/prod/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /dist /srv
RUN mkdir -p /etc/caddy/sites \
 && BB_DOMAIN=dashboard.example.invalid KC_DOMAIN=keycloak.example.invalid ACME_EMAIL=ci@example.invalid \
    caddy adapt --config /etc/caddy/Caddyfile --adapter caddyfile > /dev/null
