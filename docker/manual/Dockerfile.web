# Dashboard built for production + Caddy (one origin for app + API, second site for the Workbench preview origin).
FROM node:22-alpine AS build
ARG VITE_API_BASE_URL
ARG VITE_PREVIEW_API_ORIGIN
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_PREVIEW_API_ORIGIN=$VITE_PREVIEW_API_ORIGIN
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npx vite build --outDir /dist --emptyOutDir

FROM caddy:2-alpine
COPY docker/manual/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /dist /srv
